<?xml version="1.0" encoding="UTF-8"?>
<package xmlns="http://www.idpf.org/2007/opf" version="3.0" unique-identifier="bookid">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="bookid">urn:uuid:00000000-0000-0000-0000-000000000001</dc:identifier>
    <dc:title>Seed Book</dc:title>
    <dc:language>en</dc:language>
    <meta name="cover" content="cover"/>
  </metadata>
  <manifest>
    <!-- Cover is SVG (stored verbatim) so it is trivially byte-identical. A
         raster image is deliberately NOT in this parity fixture: stb_image's
         decode + the (v+8)/17 gray4 quantize diverge from PIL for real pixels
         (the same gap ra_rabook_gray4.h documents for LANCZOS downscale), so a
         raster cannot be byte-identical. The image LOOP still handles raster;
         only the parity fixture is pinned to SVG. -->
    <item id="cover" href="cover.svg" media-type="image/svg+xml" properties="cover-image"/>
    <item id="css1" href="style.css" media-type="text/css"/>
    <item id="ch1" href="chapter1.xhtml" media-type="application/xhtml+xml"/>
  </manifest>
  <spine>
    <itemref idref="ch1"/>
  </spine>
</package>
