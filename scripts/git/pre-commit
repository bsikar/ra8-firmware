#!/usr/bin/env bash
# Pre-commit hook for ra8d2-firmware
# Runs: ASCII check, C23 pattern check, defensive macro paren check,
#       clang-format, clang-tidy
#
# Install with:
#   ln -s ../../scripts/git/pre-commit .git/hooks/pre-commit
# or just copy this file into .git/hooks/pre-commit and chmod +x.

set -uo pipefail

# Allow skipping checks
if [[ "${1:-}" == "--no-verify" ]]; then
    exit 0
fi

# Get list of staged files
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

# Flags to track errors
error_found=0

echo "Running pre-commit checks..."

# -----------------------------------------------------------------------------
# ASCII-ONLY SOURCE CODE CHECK
# -----------------------------------------------------------------------------
ascii_ok=true
while IFS= read -r staged_file; do
    # Check all text source files by extension or by specific filename.
    if [[ "$staged_file" =~ \.(c|h|cpp|hpp|md|yml|yaml|sh|py|cmake|json|toml|cfg|conf|tex|css|html|xml|txt|ini)$ ]] \
       || [[ "$(basename "$staged_file")" =~ ^(Makefile|Dockerfile|\.clang-format|\.clang-tidy|\.clangd|\.cppcheck-suppressions|\.editorconfig|\.gitattributes|\.gitignore)$ ]]; then
        if grep -qP "[^\x00-\x7F]" "$staged_file" 2>/dev/null; then
            echo "ERROR: Non-ASCII characters in staged file: $staged_file"
            grep -nP "[^\x00-\x7F]" "$staged_file" | head -5
            ascii_ok=false
        fi
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [[ "$ascii_ok" == "false" ]]; then
    echo ""
    echo "Policy: All source files must use ASCII-only characters."
    echo "See CLAUDE.md 'Character Encoding Policy' for details."
    exit 1
fi

# -----------------------------------------------------------------------------
# C / C++ CHECKS
# -----------------------------------------------------------------------------
c_files=$(echo "$staged_files" | grep -E "\.(c|h)$" \
  | grep -vE "/(build|_deps|third_party)/" \
  || true)

if [[ -n "$c_files" ]]; then
    echo "Checking C/H files..."

    # ---- clang-format ------------------------------------------------------
    if command -v clang-format &>/dev/null; then
        if ! bash scripts/format_code.sh --check; then
            echo "[FAIL] formatting check failed."
            echo "   Run: bash scripts/format_code.sh"
            error_found=1
        fi
    else
        echo ""
        echo "WARNING: clang-format not found -- formatting check SKIPPED."
        echo "   Install: sudo apt install clang-format"
    fi

    # ---- C23 pattern enforcement -------------------------------------------
    c23_ok=true
    for f in $c_files; do
        # _Static_assert -> static_assert
        if grep -qn '_Static_assert' "$f" 2>/dev/null; then
            echo "[FAIL] C11 _Static_assert in $f (use static_assert)"
            grep -n '_Static_assert' "$f"
            c23_ok=false
        fi
        # = {0} -> = {}
        if grep -qnE '= \{0\}' "$f" 2>/dev/null; then
            echo "[FAIL] C11 = {0} initializer in $f (use = {})"
            grep -nE '= \{0\}' "$f" | head -5
            c23_ok=false
        fi
        # #include <stdbool.h> (unnecessary in C23)
        if grep -qn '#include <stdbool.h>' "$f" 2>/dev/null; then
            echo "[FAIL] Unnecessary #include <stdbool.h> in $f (bool is a C23 keyword)"
            c23_ok=false
        fi
    done
    if [[ "$c23_ok" == "false" ]]; then
        echo ""
        echo "Policy: Use C23 constructs (static_assert, = {}, no stdbool.h)."
        error_found=1
    fi

    # ---- Defensive macro paren check ---------------------------------------
    # Object-like `#define FOO 1000` is fragile in expressions: if FOO is
    # ever rewritten as `1+999`, callers like `BAR * FOO + 1` silently break.
    # Wrap as `(1000)` so the value stays a single token in every context.
    # Catches: bare integer or float literals (with optional U/L/F suffix);
    # ignores function-like macros, bare feature flags, and already-parenthesized
    # values.
    parens_ok=true
    paren_re='^[[:space:]]*#[[:space:]]*define[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]+[+-]?(0[xX][0-9a-fA-F]+[uUlL]*|0[bB][01]+[uUlL]*|[0-9]+\.[0-9]*([eE][+-]?[0-9]+)?[fFlL]?|\.[0-9]+([eE][+-]?[0-9]+)?[fFlL]?|[0-9]+([eE][+-]?[0-9]+)?[fFlLuU]*)[[:space:]]*(/[/*].*)?$'
    for f in $c_files; do
        if grep -qnE "$paren_re" "$f" 2>/dev/null; then
            echo "[FAIL] bare numeric #define value in $f (wrap with parens)"
            grep -nE "$paren_re" "$f" | head -5
            parens_ok=false
        fi
    done
    if [[ "$parens_ok" == "false" ]]; then
        echo ""
        echo "Policy: numeric #define values must be wrapped in parens."
        echo "        Example: #define FOO (1000)  not  #define FOO 1000"
        error_found=1
    fi

    # ---- clang-tidy --------------------------------------------------------
    if command -v clang-tidy &>/dev/null || command -v clang-tidy-18 &>/dev/null; then
        if ! bash scripts/clang_tidy.sh --check; then
            echo "[FAIL] clang-tidy violations found."
            echo "   Fix violations above, then re-stage and commit."
            error_found=1
        fi
    else
        echo ""
        echo "WARNING: clang-tidy not found -- static analysis SKIPPED."
        echo "   Install: sudo apt install clang-tidy"
    fi

    # ---- Doxygen @since tag enforcement -----------------------------------
    if ! python3 scripts/utils/check-since-version.py $c_files; then
        echo "[FAIL] public function declarations missing @since tags."
        echo "   Every ra_* function in a libs/ra_*/inc/*.h file must have"
        echo "   an @since tag in its preceding Doxygen block."
        error_found=1
    fi

    # ---- Copyright header enforcement -------------------------------------
    if ! python3 scripts/utils/check-copyright.py $c_files; then
        echo "[FAIL] missing or wrong copyright/SPDX header."
        error_found=1
    fi

    # ---- cppcheck ----------------------------------------------------------
    if command -v cppcheck &>/dev/null; then
        prod_files=$(echo "$c_files" | grep -vE "^tests/" || true)
        if [[ -n "$prod_files" ]]; then
            if ! cppcheck --enable=warning,style,performance,portability \
                          --error-exitcode=1 \
                          --suppressions-list=.cppcheck-suppressions \
                          --inline-suppr \
                          --std=c23 \
                          --quiet \
                          $prod_files; then
                echo "[FAIL] cppcheck violations found."
                error_found=1
            fi
        fi
    else
        echo ""
        echo "WARNING: cppcheck not found -- static analysis SKIPPED."
        echo "   Install: sudo apt install cppcheck"
    fi
fi

# -----------------------------------------------------------------------------
# WAVE-0 CHECKS: HUM citations, world tags, roadmap summary
# -----------------------------------------------------------------------------
# These three checks were introduced in Wave 0 of the HAL completion
# plan. cite_check + check_world_tags run in WARN mode in Wave 0 and
# get promoted to STRICT in later waves. roadmap_stats runs in --check
# mode (the script itself never edits files in pre-commit; the
# developer is expected to run it without --check to refresh).

# ---- HUM citation validator (warn in Wave 0) ----------------------
if [[ -f scripts/utils/cite_check.py ]]; then
    if ! python3 scripts/utils/cite_check.py --warn; then
        echo "[FAIL] cite_check.py reported issues."
        error_found=1
    fi
fi

# ---- World-tag validator (warn in Wave 0) -------------------------
if [[ -f scripts/utils/check_world_tags.py ]]; then
    if ! python3 scripts/utils/check_world_tags.py --warn; then
        echo "[FAIL] check_world_tags.py reported issues."
        error_found=1
    fi
fi

# ---- ROADMAP summary stats (strict: refuse stale summaries) -------
if [[ -f scripts/utils/roadmap_stats.py && -f docs/ROADMAP.md ]]; then
    if ! python3 scripts/utils/roadmap_stats.py --check; then
        echo "[FAIL] ROADMAP.md summary block is stale."
        echo "       Run: python3 scripts/utils/roadmap_stats.py"
        echo "       Then re-stage docs/ROADMAP.md and re-commit."
        error_found=1
    fi
fi

# -----------------------------------------------------------------------------
# CONCLUSION
# -----------------------------------------------------------------------------
if [[ $error_found -ne 0 ]]; then
    echo "[FAIL] Commit rejected due to linting/formatting errors."
    exit 1
fi

echo "[PASS] All checks passed."
exit 0
