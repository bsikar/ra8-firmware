#!/bin/bash -p
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Brighton Sikarskie
# SHEBANG-SECURITY: -p blocks BASH_ENV and exported-function startup injection.
if [[ "$-" == *p* ]]; then
  unset -v BASH_ENV ENV
  declare -a ra8_startup_env_unset=()
  _ra8_startup_refuse() {
    printf 'error: privileged startup %s\n' "$1" >&2
    exit 1
  }
  ra8_startup_env_done_count=0
  while IFS= read -r -d '' ra8_startup_env_row; do
    ra8_startup_env_name="${ra8_startup_env_row%%=*}"
    case "$ra8_startup_env_name" in
      RA8_STARTUP_ENV_DONE)
        ra8_startup_env_done_count=$((ra8_startup_env_done_count + 1))
        ;;
      BASH_FUNC_*%% | BASH_FUNC_*'()') ra8_startup_env_unset+=(-u "$ra8_startup_env_name") ;;
    esac
  done < <(
    /usr/bin/env -u RA8_STARTUP_ENV_DONE -0 &&
      /usr/bin/printf 'RA8_STARTUP_ENV_DONE=1\0'
  )
  ((ra8_startup_env_done_count == 1)) && [[ "$ra8_startup_env_name" == RA8_STARTUP_ENV_DONE ]] || _ra8_startup_refuse 'environment enumeration was incomplete'
  if ((${#ra8_startup_env_unset[@]})); then
    [[ -z "${RA8_STARTUP_ENV_SCRUBBED-}" ]] || _ra8_startup_refuse 'scrub did not converge'
    ra8_startup_reentry="$0"
    [[ "$ra8_startup_reentry" == */* ]] || _ra8_startup_refuse 'requires a script path'
    if [[ "$ra8_startup_reentry" != /* ]]; then
      ra8_startup_reentry="$PWD/$ra8_startup_reentry"
    fi
    ra8_startup_check="$ra8_startup_reentry"
    while [[ "$ra8_startup_check" != "/" ]]; do
      [[ ! -L "$ra8_startup_check" ]] || _ra8_startup_refuse 'refuses a symlinked path'
      ra8_startup_parent="${ra8_startup_check%/*}"
      [[ -n "$ra8_startup_parent" ]] || ra8_startup_parent="/"
      [[ "$ra8_startup_parent" != "$ra8_startup_check" ]] ||
        _ra8_startup_refuse 'cannot validate its script path'
      ra8_startup_check="$ra8_startup_parent"
    done
    [[ -f "$ra8_startup_reentry" ]] || _ra8_startup_refuse 'refuses a non-regular path'
    if ! exec /usr/bin/env "${ra8_startup_env_unset[@]}" -u BASH_ENV -u ENV \
      -u RA8_STARTUP_ENV_DONE RA8_STARTUP_ENV_SCRUBBED=1 \
      /bin/bash -p -- "$ra8_startup_reentry" "$@"; then
      _ra8_startup_refuse 'could not enter sanitized process'
    fi
  fi
  unset -v ra8_startup_check ra8_startup_env_done_count
  unset -v ra8_startup_env_name ra8_startup_env_row
  unset -v ra8_startup_env_unset ra8_startup_parent ra8_startup_reentry
  unset -v RA8_STARTUP_ENV_DONE
  unset -v RA8_STARTUP_ENV_SCRUBBED
  unset -f _ra8_startup_refuse

  set -euo pipefail

  unset BASH_ENV ENV PYTHONHOME PYTHONPATH
  unalias git python3 bash 2>/dev/null || true
  unset -f git python3 bash 2>/dev/null || true
  hash -r
  RA8_OWNER_PATH=/usr/bin:/bin:/usr/sbin:/sbin
  PATH="$RA8_OWNER_PATH"
  export PATH RA8_OWNER_PATH
  TRUSTED_GIT=/usr/bin/git
  [[ -f "$TRUSTED_GIT" && ! -L "$TRUSTED_GIT" && -x "$TRUSTED_GIT" ]] || {
    echo "pre-commit: trusted /usr/bin/git is unavailable or unsafe" >&2
    exit 1
  }
  [[ "${RA8_TRUSTED_GIT:-$TRUSTED_GIT}" == "$TRUSTED_GIT" ]] || {
    echo "pre-commit: refusing non-authority Git executable" >&2
    exit 1
  }
  export RA8_TRUSTED_GIT="$TRUSTED_GIT"

  RA8_HOOK_ABORTED=3
  SOURCE_ROOT=""
  SOURCE_INDEX=""
  SOURCE_ALTERNATES=""
  SOURCE_GIT_DIR=""
  SOURCE_OBJECTS=""
  SOURCE_HEAD=""
  SOURCE_INDEX_BEFORE=""
  SNAPSHOT_DIR=""
  POLICY_TMPDIR=""
  CONTROL_DIR=""
  CHILD_PID=""
  POLICY_RC=0
  PENDING_SIGNAL=""
  READY_PATH=""
  PROOF_PATH=""
  PROOF_TOKEN=""
  OWNER_BASH=""
  OWNER_PYTHON=""
  OWNER_JUST=""
  OWNER_TOOL_DIR=""

  IFS= read -r -d '' SUPERVISOR_PROGRAM <<'PY' || true
import os
import signal
import subprocess
import sys
import time

ABORTED = 3
DRAIN_SECONDS = 5.0
ready_path, *command = sys.argv[1:]
proc = None
status = 70


def reset_child_signals():
    for item in (signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM):
        signal.signal(item, signal.SIG_DFL)


def group_exists(pgid):
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    return True


def wait_group_empty(pgid, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not group_exists(pgid):
            return True
        time.sleep(0.05)
    return not group_exists(pgid)


def drain_group(process, signum):
    try:
        os.killpg(process.pid, signum)
    except ProcessLookupError:
        pass
    try:
        process.wait(timeout=DRAIN_SECONDS)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait(timeout=DRAIN_SECONDS)
    if wait_group_empty(process.pid, DRAIN_SECONDS):
        return True
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    return wait_group_empty(process.pid, DRAIN_SECONDS)


class ForwardedSignal(Exception):
    def __init__(self, signum):
        super().__init__(signum)
        self.signum = signum


def forward_signal(signum, _frame):
    raise ForwardedSignal(signum)


try:
    proc = subprocess.Popen(
        command,
        start_new_session=True,
        preexec_fn=reset_child_signals,
    )
    for handled in (signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM):
        signal.signal(handled, forward_signal)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(ready_path, flags, 0o600)
    try:
        payload = f"{proc.pid}\n".encode("ascii")
        written = os.write(fd, payload)
        if written != len(payload):
            raise OSError("short readiness write")
    finally:
        os.close(fd)
    status = proc.wait()
    if group_exists(proc.pid) and not drain_group(proc, signal.SIGTERM):
        status = 70
except ForwardedSignal as forwarded:
    status = ABORTED if proc is not None and drain_group(proc, forwarded.signum) else 70
except BaseException:
    if proc is not None:
        drain_group(proc, signal.SIGTERM)
    raise
finally:
    if proc is not None and group_exists(proc.pid):
        drain_group(proc, signal.SIGKILL)
    if proc is not None and proc.poll() is None:
        proc.kill()
        proc.wait(timeout=DRAIN_SECONDS)
sys.exit(status)
PY
  [[ -n "$SUPERVISOR_PROGRAM" ]] || exit 1

  die() {
    echo "pre-commit: $*" >&2
    return 1
  }

  cleanup_snapshot() {
    if [[ -n "$SNAPSHOT_DIR" && -d "$SNAPSHOT_DIR" ]]; then
      rm -rf -- "$SNAPSHOT_DIR"
      SNAPSHOT_DIR=""
    fi
    if [[ -n "$CONTROL_DIR" && -d "$CONTROL_DIR" ]]; then
      rm -rf -- "$CONTROL_DIR"
      CONTROL_DIR=""
    fi
  }

  terminate_policy_group() {
    local sig="$1" pid="${CHILD_PID:-}"
    [[ -n "$pid" ]] || return 0
    kill -s "$sig" -- "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    CHILD_PID=""
  }

  abort_on_signal() {
    local sig="$1"
    trap - HUP INT QUIT TERM
    terminate_policy_group "$sig"
    cleanup_snapshot
    echo "pre-commit: ABORTED by SIG${sig}; no commit verdict was produced." >&2
    exit "$RA8_HOOK_ABORTED"
  }

  queue_owner_signal() {
    [[ -n "$PENDING_SIGNAL" ]] || PENDING_SIGNAL="$1"
  }

  install_owner_traps() {
    trap cleanup_snapshot EXIT
    trap 'queue_owner_signal HUP' HUP
    trap 'queue_owner_signal INT' INT
    trap 'queue_owner_signal QUIT' QUIT
    trap 'queue_owner_signal TERM' TERM
  }

  activate_owner_signal_forwarding() {
    local pending="$PENDING_SIGNAL"
    trap 'abort_on_signal HUP' HUP
    trap 'abort_on_signal INT' INT
    trap 'abort_on_signal QUIT' QUIT
    trap 'abort_on_signal TERM' TERM
    if [[ -n "$pending" ]]; then
      abort_on_signal "$pending"
    fi
  }

  install_strict_git_environment() {
    local name
    while IFS='=' read -r name _; do
      if [[ "$name" == GIT_* ]]; then
        [[ "$name" =~ ^GIT_[A-Za-z0-9_]+$ ]] || die "unsafe Git environment name"
        unset "$name"
      fi
    done < <(env)
    unset BASH_ENV DIFF EDITOR ENV LESS LV MERGE_TOOL PAGER PYTHONHOME PYTHONPATH SSH_ASKPASS SUDO_ASKPASS VISUAL
    export GIT_ATTR_NOSYSTEM=1
    export GIT_CONFIG_GLOBAL=/dev/null
    export GIT_CONFIG_NOSYSTEM=1
    export GIT_CONFIG_SYSTEM=/dev/null
    export GIT_EDITOR=false
    export GIT_OPTIONAL_LOCKS=0
    export GIT_PAGER=cat
    export GIT_SEQUENCE_EDITOR=false
    export GIT_SSH_COMMAND=false
    export GIT_TERMINAL_PROMPT=0
    export GIT_CONFIG_COUNT=3
    export GIT_CONFIG_KEY_0=core.hooksPath
    export GIT_CONFIG_VALUE_0=/dev/null
    export GIT_CONFIG_KEY_1=core.fsmonitor
    export GIT_CONFIG_VALUE_1=false
    export GIT_CONFIG_KEY_2=core.attributesFile
    export GIT_CONFIG_VALUE_2=/dev/null
    export PAGER=cat
    export TERM=dumb
    return 0
  }

  init_private_repository() {
    local root="$1" template="${1}.empty-template"
    mkdir -p "$root" "$template"
    "$TRUSTED_GIT" -C "$root" -c init.templateDir="$template" init --quiet
    rm -rf -- "$template"
  }

  active_index_path() {
    local source="$1" inherited="${GIT_INDEX_FILE-}"
    if [[ -n "$inherited" ]]; then
      case "$inherited" in
        /*) printf '%s\n' "$inherited" ;;
        *) printf '%s/%s\n' "$(pwd -P)" "$inherited" ;;
      esac
      return 0
    fi
    "$TRUSTED_GIT" -C "$source" rev-parse --path-format=absolute --git-path index
  }

  validate_inherited_alternates() {
    local raw="${GIT_ALTERNATE_OBJECT_DIRECTORIES-}" entry
    local -a entries=()
    [[ -n "$raw" ]] || return 0
    [[ "$raw" != *$'\n'* && "$raw" != *$'\r'* && "$raw" != *'"'* && "$raw" != *"'"* ]] ||
      die "inherited Git alternates contain quoting or control characters"
    IFS=':' read -r -a entries <<<"$raw"
    [[ "${#entries[@]}" -gt 0 ]] || die "inherited Git alternates are empty"
    for entry in "${entries[@]}"; do
      [[ -n "$entry" ]] || die "inherited Git alternates contain an empty entry"
      [[ "$entry" == /* ]] || die "inherited Git alternate is not absolute: $entry"
      [[ -d "$entry" && ! -L "$entry" ]] ||
        die "inherited Git alternate is unavailable or linked: $entry"
    done
  }

  capture_source() {
    local alternate alternate_report
    validate_inherited_alternates
    SOURCE_ROOT="$("$TRUSTED_GIT" rev-parse --show-toplevel)"
    SOURCE_ROOT="$(cd "$SOURCE_ROOT" && pwd -P)"
    SOURCE_INDEX="$(active_index_path "$SOURCE_ROOT")"
    SOURCE_GIT_DIR="$("$TRUSTED_GIT" -C "$SOURCE_ROOT" rev-parse --path-format=absolute --absolute-git-dir)"
    SOURCE_OBJECTS="$("$TRUSTED_GIT" -C "$SOURCE_ROOT" rev-parse --path-format=absolute --git-path objects)"
    SOURCE_HEAD="$("$TRUSTED_GIT" -C "$SOURCE_ROOT" rev-parse --verify HEAD)"
    alternate_report="$("$TRUSTED_GIT" -C "$SOURCE_ROOT" count-objects -v)"
    SOURCE_ALTERNATES=""
    while IFS= read -r alternate; do
      [[ "$alternate" == "alternate: "* ]] || continue
      alternate="${alternate#alternate: }"
      [[ "$alternate" == /* && -d "$alternate" && ! -L "$alternate" ]] ||
        die "Git alternate is not an absolute regular directory: $alternate"
      [[ "$alternate" != *:* && "$alternate" != *$'\n'* ]] ||
        die "Git alternate contains an unsafe separator"
      SOURCE_ALTERNATES="${SOURCE_ALTERNATES:+$SOURCE_ALTERNATES:}$alternate"
    done <<<"$alternate_report"
    [[ -f "$SOURCE_INDEX" && ! -L "$SOURCE_INDEX" ]] ||
      die "active Git index is absent, linked, or not a regular file"
    [[ -d "$SOURCE_OBJECTS" && ! -L "$SOURCE_OBJECTS" ]] ||
      die "primary Git object directory is absent, linked, or not a directory"
    SOURCE_INDEX_BEFORE="$("$TRUSTED_GIT" hash-object --no-filters -- "$SOURCE_INDEX")"
    install_strict_git_environment
  }

  source_metadata() {
    case "$SOURCE_GIT_DIR:$SOURCE_OBJECTS:$SOURCE_ALTERNATES" in
      *$'\n'*) die "Git source routing contains a newline" ;;
    esac
    [[ "$SOURCE_GIT_DIR" == /* && "$SOURCE_OBJECTS" == /* ]] ||
      die "Git source routing is not absolute"
  }

  resolve_owner_tools() {
    local account_home candidate resolved
    OWNER_BASH=/bin/bash
    OWNER_PYTHON=/usr/bin/python3
    [[ -f "$OWNER_BASH" && ! -L "$OWNER_BASH" && -x "$OWNER_BASH" ]] ||
      die "trusted /bin/bash is required"
    [[ -x "$OWNER_PYTHON" ]] || die "trusted /usr/bin/python3 is required"
    account_home="$("$OWNER_PYTHON" -I -c \
      'import os, pwd; print(pwd.getpwuid(os.getuid()).pw_dir)')"
    [[ "$account_home" == /* && "$account_home" != *$'\n'* ]] ||
      die "system account home is not an absolute single-line path"
    OWNER_JUST=""
    for candidate in \
      /usr/local/bin/just \
      /opt/homebrew/bin/just \
      /home/linuxbrew/.linuxbrew/bin/just \
      /usr/bin/just \
      "$account_home/.local/bin/just"; do
      [[ -x "$candidate" ]] || continue
      resolved="$("$OWNER_PYTHON" -I -c \
        'import os, sys; print(os.path.realpath(sys.argv[1]))' "$candidate")"
      [[ "$resolved" == /* && "$resolved" != *$'\n'* && -f "$resolved" && ! -L "$resolved" && -x "$resolved" ]] ||
        continue
      OWNER_JUST="$resolved"
      break
    done
    [[ -n "$OWNER_JUST" ]] || die "just is absent from the fixed supported-host locations"
    case "$OWNER_JUST" in
      "$SOURCE_ROOT/"*) die "owner Just resolves through the mutable source tree" ;;
    esac
    [[ "$OWNER_PYTHON" == /* && "$OWNER_BASH" == /* && "$OWNER_JUST" == /* ]] ||
      die "owner tools must resolve to absolute paths"
  }

  prepare_private_repository() {
    SNAPSHOT_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ra8-staged-hook.XXXXXXXX")"
    SNAPSHOT_DIR="$(cd "$SNAPSHOT_DIR" && pwd -P)"
    init_private_repository "$SNAPSHOT_DIR"
    POLICY_TMPDIR="$SNAPSHOT_DIR/.git/policy-tmp"
    mkdir -m 700 "$POLICY_TMPDIR"
    COPIED_INDEX="$SNAPSHOT_DIR/.git/candidate.index"
    CAPTURE_OBJECTS="$SNAPSHOT_DIR/.git/candidate-objects"
    mkdir -p "$CAPTURE_OBJECTS" "$SNAPSHOT_DIR/.git/objects/info"
    cp -- "$SOURCE_INDEX" "$COPIED_INDEX"
  }

  write_candidate_tree() {
    local read_path
    read_path="$SOURCE_OBJECTS${SOURCE_ALTERNATES:+:$SOURCE_ALTERNATES}"
    CANDIDATE_TREE="$(GIT_DIR="$SOURCE_GIT_DIR" GIT_WORK_TREE="$SOURCE_ROOT" \
      GIT_INDEX_FILE="$COPIED_INDEX" GIT_OBJECT_DIRECTORY="$CAPTURE_OBJECTS" \
      GIT_ALTERNATE_OBJECT_DIRECTORIES="$read_path" "$TRUSTED_GIT" write-tree)"
    {
      printf '%s\n' "$SOURCE_OBJECTS"
      if [[ -n "$SOURCE_ALTERNATES" ]]; then
        local -a entries=()
        IFS=':' read -r -a entries <<<"$SOURCE_ALTERNATES"
        printf '%s\n' "${entries[@]}"
      fi
      printf '%s\n' "$CAPTURE_OBJECTS"
    } >"$SNAPSHOT_DIR/.git/objects/info/alternates"
  }

  checkout_candidate_tree() {
    "$TRUSTED_GIT" -C "$SNAPSHOT_DIR" update-ref HEAD "$SOURCE_HEAD"
    "$TRUSTED_GIT" -C "$SNAPSHOT_DIR" read-tree "$CANDIDATE_TREE"
    GIT_LFS_SKIP_SMUDGE=1 "$TRUSTED_GIT" -C "$SNAPSHOT_DIR" checkout-index --all
  }

  verify_candidate_tree() {
    local snapshot_tree source_after sentinel
    snapshot_tree="$("$TRUSTED_GIT" -C "$SNAPSHOT_DIR" write-tree)"
    [[ "$snapshot_tree" == "$CANDIDATE_TREE" ]] || die "snapshot tree differs from active index"
    "$TRUSTED_GIT" -C "$SNAPSHOT_DIR" diff --quiet --no-ext-diff || die "snapshot worktree differs from index"
    [[ -z "$("$TRUSTED_GIT" -C "$SNAPSHOT_DIR" ls-files --others --exclude-standard)" ]] ||
      die "snapshot contains untracked paths"
    source_after="$("$TRUSTED_GIT" hash-object --no-filters -- "$SOURCE_INDEX")"
    [[ "$source_after" == "$SOURCE_INDEX_BEFORE" ]] || die "source index was modified"
    for sentinel in scripts/ci.sh scripts/ci/gates scripts/dev/run_just.sh justfile just/hooks.just; do
      [[ -e "$SNAPSHOT_DIR/$sentinel" ]] || die "snapshot is missing $sentinel"
    done
  }

  prepare_head_control_plane() {
    local control_tree expected_tree entry
    local -a entries=()
    CONTROL_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ra8-head-policy.XXXXXXXX")"
    CONTROL_DIR="$(cd "$CONTROL_DIR" && pwd -P)"
    init_private_repository "$CONTROL_DIR"
    mkdir -p "$CONTROL_DIR/.git/objects/info"
    {
      printf '%s\n' "$SOURCE_OBJECTS"
      if [[ -n "$SOURCE_ALTERNATES" ]]; then
        IFS=':' read -r -a entries <<<"$SOURCE_ALTERNATES"
        for entry in "${entries[@]}"; do
          [[ -n "$entry" ]] && printf '%s\n' "$entry"
        done
      fi
    } >"$CONTROL_DIR/.git/objects/info/alternates"
    "$TRUSTED_GIT" -C "$CONTROL_DIR" update-ref HEAD "$SOURCE_HEAD"
    "$TRUSTED_GIT" -C "$CONTROL_DIR" read-tree "$SOURCE_HEAD"
    GIT_LFS_SKIP_SMUDGE=1 "$TRUSTED_GIT" -C "$CONTROL_DIR" checkout-index --all
    control_tree="$("$TRUSTED_GIT" -C "$CONTROL_DIR" write-tree)"
    expected_tree="$("$TRUSTED_GIT" -C "$SOURCE_ROOT" rev-parse "$SOURCE_HEAD^{tree}")"
    [[ "$control_tree" == "$expected_tree" ]] || die "HEAD control-plane tree differs from HEAD"
    "$TRUSTED_GIT" -C "$CONTROL_DIR" diff --quiet --no-ext-diff || die "HEAD control plane is dirty"
    [[ -x "$CONTROL_DIR/scripts/checks/check_hook_parity.py" ]] ||
      die "HEAD does not own an executable hook validator"
  }

  make_policy_tools() {
    OWNER_TOOL_DIR="$SNAPSHOT_DIR/.git/owner-tools"
    mkdir -m 700 "$OWNER_TOOL_DIR"
    ln -s "$OWNER_BASH" "$OWNER_TOOL_DIR/bash"
    ln -s "$TRUSTED_GIT" "$OWNER_TOOL_DIR/git"
    [[ -L "$OWNER_TOOL_DIR/bash" ]] || die "trusted policy Bash shim is absent"
    [[ -L "$OWNER_TOOL_DIR/git" ]] || die "trusted policy Git shim is absent"
    [[ "$(readlink "$OWNER_TOOL_DIR/bash")" == "$OWNER_BASH" ]] ||
      die "trusted policy Bash shim changed target"
    [[ "$(readlink "$OWNER_TOOL_DIR/git")" == "$TRUSTED_GIT" ]] ||
      die "trusted policy Git shim changed target"
  }

  write_policy_population() {
    local tree="$1" target="$2"
    "$TRUSTED_GIT" -C "$SNAPSHOT_DIR" ls-tree -rz --full-tree "$tree" |
      "$OWNER_PYTHON" -I -c '
import pathlib
import sys

target = pathlib.Path(sys.argv[1])
selected = []
for row in sys.stdin.buffer.read().split(b"\0"):
    if not row:
        continue
    _, separator, raw_path = row.partition(b"\t")
    if not separator:
        raise SystemExit("malformed policy tree row")
    name = raw_path.rsplit(b"/", 1)[-1]
    if name in {b".gitattributes", b".gitignore"}:
        selected.append(row)
target.write_bytes(b"\0".join(selected) + (b"\0" if selected else b""))
' "$target"
  }

  verify_bootstrap_policy_population() {
    local head_population="$SNAPSHOT_DIR/.git/head-policy.population"
    local candidate_population="$SNAPSHOT_DIR/.git/candidate-policy.population"
    write_policy_population "$SOURCE_HEAD" "$head_population"
    write_policy_population "$CANDIDATE_TREE" "$candidate_population"
    "$OWNER_PYTHON" -I -c '
import pathlib
import sys

head = pathlib.Path(sys.argv[1]).read_bytes()
candidate = pathlib.Path(sys.argv[2]).read_bytes()
if candidate != head:
    raise SystemExit("bootstrap policy population differs from HEAD")
rows = [row for row in head.split(b"\0") if row]
names = [row.partition(b"\t")[2].rsplit(b"/", 1)[-1] for row in rows]
attributes = names.count(b".gitattributes")
ignores = names.count(b".gitignore")
if (attributes, ignores) != (6, 27):
    raise SystemExit(
        f"bootstrap policy population changed: {attributes} attributes, {ignores} ignores"
    )
' "$head_population" "$candidate_population" ||
      die "candidate policy is not safe for the pre-validator bootstrap"
  }

  head_supports_attribute_validation() {
    "$OWNER_PYTHON" -I -c '
import pathlib
import sys

data = pathlib.Path(sys.argv[1]).read_bytes()
raise SystemExit(0 if b"--check-attributes" in data else 1)
' "$CONTROL_DIR/scripts/dev/git_environment.py"
  }

  run_head_validator() {
    local policy_path="$OWNER_TOOL_DIR:$RA8_OWNER_PATH"
    if head_supports_attribute_validation; then
      "$OWNER_PYTHON" -I "$CONTROL_DIR/scripts/dev/git_environment.py" \
        --check-attributes "$SNAPSHOT_DIR"
    else
      verify_bootstrap_policy_population
    fi
    RA8_HOOK_POLICY_ROOT="$SNAPSHOT_DIR" PATH="$policy_path" \
      "$OWNER_PYTHON" -I "$CONTROL_DIR/scripts/checks/check_hook_parity.py" --candidate-selftest
    RA8_HOOK_POLICY_ROOT="$SNAPSHOT_DIR" PATH="$policy_path" \
      "$OWNER_PYTHON" -I "$CONTROL_DIR/scripts/checks/check_hook_parity.py"
  }

  make_owner_proof() {
    PROOF_PATH="$SNAPSHOT_DIR/.git/pre-commit.proof"
    PROOF_TOKEN="$(printf '%s\0%s\0%s\n' "$$" "$RANDOM" "$SOURCE_INDEX_BEFORE" |
      "$TRUSTED_GIT" hash-object --stdin)"
    printf '%s\n' "$PROOF_TOKEN" |
      "$OWNER_PYTHON" -I "$CONTROL_DIR/scripts/git/write-proof.py" "$PROOF_PATH"
  }

  wait_policy_ready() {
    local n value="" rc=0
    for ((n = 0; n < 200; n++)); do
      if [[ -f "$READY_PATH" && ! -L "$READY_PATH" ]]; then
        value="$(<"$READY_PATH")"
        if [[ "$value" =~ ^[1-9][0-9]*$ ]]; then
          activate_owner_signal_forwarding
          return 0
        fi
      fi
      if ! kill -0 "$CHILD_PID" 2>/dev/null; then
        set +e
        wait "$CHILD_PID"
        rc=$?
        set -e
        CHILD_PID=""
        die "policy supervisor exited before readiness (status $rc)"
        return 1
      fi
      sleep 0.05
    done
    terminate_policy_group TERM
    die "policy supervisor did not establish a process group"
    return 1
  }

  run_snapshot_policy() {
    local policy_path="$OWNER_TOOL_DIR" rc=0
    if [[ -d "$SOURCE_ROOT/.venv/bin" ]]; then
      policy_path="$policy_path:$SOURCE_ROOT/.venv/bin"
    fi
    policy_path="$policy_path:$RA8_OWNER_PATH"
    READY_PATH="$SNAPSHOT_DIR/.git/policy-ready"
    cd "$SNAPSHOT_DIR"
    OLDPWD="$SNAPSHOT_DIR"
    export OLDPWD
    PATH="$policy_path" TMPDIR="$POLICY_TMPDIR" RA8_STAGED_HOOK_SNAPSHOT=1 \
      "$OWNER_PYTHON" -I -c "$SUPERVISOR_PROGRAM" "$READY_PATH" \
      "$OWNER_JUST" \
      --shell "$OWNER_BASH" --clear-shell-args --shell-arg -puc \
      --justfile "$SNAPSHOT_DIR/justfile" --working-directory "$SNAPSHOT_DIR" \
      git_hooks::pre-commit &
    CHILD_PID=$!
    wait_policy_ready
    set +e
    wait "$CHILD_PID"
    rc=$?
    set -e
    CHILD_PID=""
    cd "$SOURCE_ROOT"
    POLICY_RC="$rc"
    return 0
  }

  verify_completion_proof() {
    local actual=""
    if [[ ! -f "$PROOF_PATH" || -L "$PROOF_PATH" ]]; then
      die "snapshot policy exited without its final completion proof"
      return 1
    fi
    actual="$(<"$PROOF_PATH")"
    if [[ "$actual" != "$PROOF_TOKEN" ]]; then
      die "snapshot policy completion proof is invalid"
      return 1
    fi
  }

  verify_source_unchanged() {
    local source_after
    source_after="$("$TRUSTED_GIT" hash-object --no-filters -- "$SOURCE_INDEX")"
    [[ "$source_after" == "$SOURCE_INDEX_BEFORE" ]] || die "source index changed during policy"
  }

  main() {
    local rc=0
    [[ "$#" -eq 0 ]] || die "this Git hook accepts no arguments"
    install_owner_traps
    capture_source
    source_metadata
    resolve_owner_tools
    prepare_private_repository
    write_candidate_tree
    checkout_candidate_tree
    verify_candidate_tree
    prepare_head_control_plane
    make_policy_tools
    run_head_validator
    run_snapshot_policy
    rc="$POLICY_RC"
    if [[ "$rc" == "0" ]]; then
      make_owner_proof
      verify_completion_proof
      verify_source_unchanged
    fi
    cleanup_snapshot
    trap - EXIT HUP INT QUIT TERM
    return "$rc"
  }

  main "$@"
else
  [[ "$-" == *p* ]]
fi
