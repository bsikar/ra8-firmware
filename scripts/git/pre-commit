#!/usr/bin/env bash
# Pre-commit hook for ra8-firmware
# Runs: ASCII check, C23 pattern check, defensive macro paren check,
#       clang-format, clang-tidy
#
# Install with:
#   ln -s ../../scripts/git/pre-commit .git/hooks/pre-commit
# or just copy this file into .git/hooks/pre-commit and chmod +x.

set -uo pipefail

# Allow skipping checks
if [[ "${1:-}" == "--no-verify" ]]; then
  exit 0
fi

# Get list of staged files
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

# Flags to track errors
error_found=0

echo "Running pre-commit checks..."

# -----------------------------------------------------------------------------
# ASCII-ONLY SOURCE CODE CHECK
# -----------------------------------------------------------------------------
ascii_ok=true
while IFS= read -r staged_file; do
  # Check all text source files by extension or by specific filename.
  if [[ "$staged_file" =~ \.(c|h|cpp|hpp|md|yml|yaml|sh|py|cmake|json|toml|cfg|conf|tex|css|html|xml|txt|ini)$ ]] ||
    [[ "$(basename "$staged_file")" =~ ^(Makefile|Dockerfile|\.clang-format|\.clang-tidy|\.clangd|\.cppcheck-suppressions|\.editorconfig|\.gitattributes|\.gitignore)$ ]]; then
    if grep -qP "[^\x00-\x7F]" "$staged_file" 2>/dev/null; then
      echo "ERROR: Non-ASCII characters in staged file: $staged_file"
      grep -nP "[^\x00-\x7F]" "$staged_file" | head -5
      ascii_ok=false
    fi
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [[ "$ascii_ok" == "false" ]]; then
  echo ""
  echo "Policy: All source files must use ASCII-only characters."
  echo "See CLAUDE.md 'Character Encoding Policy' for details."
  exit 1
fi

# -----------------------------------------------------------------------------
# C / C++ CHECKS
# -----------------------------------------------------------------------------
c_files=$(echo "$staged_files" | grep -E "\.(c|h)$" |
  grep -vE "/(build|_deps|third_party)/" ||
  true)

if [[ -n "$c_files" ]]; then
  echo "Checking C/H files..."

  # Array form of the same list. The checkers below take a file list as argv,
  # and passing the raw newline-separated string relies on word splitting --
  # which silently mangles any path containing whitespace. mapfile splits on
  # newlines only, so "${c_file_list[@]}" is safe for every path git can hand
  # us. (This hook went unshellchecked until check_shell.py started sweeping
  # by shebang; SC2086 flagged five such call sites here.)
  mapfile -t c_file_list <<<"$c_files"

  # ---- clang-format ------------------------------------------------------
  if command -v clang-format &>/dev/null; then
    if ! bash scripts/checks/format_code.sh --check; then
      echo "[FAIL] formatting check failed."
      echo "   Run: bash scripts/checks/format_code.sh"
      error_found=1
    fi
  else
    echo ""
    echo "WARNING: clang-format not found -- formatting check SKIPPED."
    echo "   Install: sudo apt install clang-format"
  fi

  # ---- C23 source patterns -----------------------------------------------
  # The four checks below (_Static_assert -> static_assert, = {0} -> = {},
  # no <stdbool.h>, and paren-wrapped numeric #define values) were inline grep
  # loops here for the life of the hook and were NOT run by the CI
  # pre-commit-checks gate, so a violation the hook rejects passed CI on any
  # machine whose hook was not installed. They now live in one first-party
  # checker that BOTH this hook and gate_pre_commit_checks call, so there is a
  # single definition of each rule (#407). The checker skips comments and
  # string literals, which the raw greps did not.
  if ! python3 scripts/checks/check_c23_patterns.py "${c_file_list[@]}"; then
    echo "[FAIL] C23 source-pattern violation(s)."
    echo "   Use static_assert, = {}, drop <stdbool.h>, and wrap bare"
    echo "   numeric #define values in parens (e.g. #define FOO (1000))."
    error_found=1
  fi

  # ---- clang-tidy --------------------------------------------------------
  if command -v clang-tidy &>/dev/null || command -v clang-tidy-18 &>/dev/null; then
    if ! bash scripts/checks/clang_tidy.sh --check; then
      echo "[FAIL] clang-tidy violations found."
      echo "   Fix violations above, then re-stage and commit."
      error_found=1
    fi
  else
    echo ""
    echo "WARNING: clang-tidy not found -- static analysis SKIPPED."
    echo "   Install: sudo apt install clang-tidy"
  fi

  # ---- Doxygen full-coverage audit (strict: zero gaps required) ---------
  # Runs only when C/H files are staged. Scans libs/, src/, port/ for any
  # function that is missing a required Doxygen tag per CLAUDE.md.
  if [[ -f scripts/checks/doxy_audit.py ]]; then
    # Regression-test the auditor before trusting it: a regex-driven gate
    # that stops recognising a construct reports zero gaps, which is
    # indistinguishable from a fully documented tree.
    if ! python3 scripts/checks/doxy_audit.py --selftest; then
      echo "[FAIL] doxy_audit.py selftest failed -- the auditor itself is broken."
      echo "       Do not trust the --check result below until this passes."
      error_found=1
    fi
    if ! python3 scripts/checks/doxy_audit.py --check; then
      echo "[FAIL] doxy_audit.py reported documentation gaps."
      echo "       Every function in libs/, src/, port/ must have the"
      echo "       full required Doxygen tag set (see CLAUDE.md)."
      error_found=1
    fi
    # Member gate (#246): every enum value, struct/union member, and macro
    # across the first-party tree must carry a doc comment.
    if ! python3 scripts/checks/doxy_audit.py --members --check; then
      echo "[FAIL] doxy_audit.py reported undocumented members."
      echo "       Every enum value, struct/union member, and macro must"
      echo "       carry a /**< ... */ (or preceding /** ... */) doc"
      echo "       comment; macros need a /** @brief ... */ block."
      error_found=1
    fi
  fi

  # ---- Doxygen attachment gate (strict: zero findings required) ---------
  # doxy_audit above checks only that a block EXISTS. This one checks that
  # the block describes the symbol it sits on -- pasted @param names, a
  # @retval on a void function, two blocks in a row, a block naming another
  # symbol, a block stranded on a forward declaration. A misattached block
  # SATISFIES the presence gate, so nothing else catches these.
  # Needs libclang; skipped with a warning locally when it is absent (CI
  # installs a pinned wheel and fails hard if the import breaks).
  if [[ -f scripts/checks/check_doc_attachment.py ]]; then
    if ! python3 -c "import clang.cindex" 2>/dev/null; then
      echo "WARNING: libclang missing -- doc-attachment gate SKIPPED."
      echo "   Install: python3 -m pip install --user libclang"
    else
      if ! python3 scripts/checks/check_doc_attachment.py --selftest; then
        echo "[FAIL] check_doc_attachment.py selftest failed -- the"
        echo "       checker itself is broken; fix it before trusting"
        echo "       any verdict it gives."
        error_found=1
      elif ! python3 scripts/checks/check_doc_attachment.py --check; then
        echo "[FAIL] check_doc_attachment.py found doc blocks that do"
        echo "       not describe what they are attached to."
        error_found=1
      fi
    fi
  fi

  # ---- Per-app init-order audit (strict: zero violations) ---------------
  # Walks every examples/<tier>/<app>/main.c and verifies the canonical
  # CGC -> MSTP -> IOPORT -> TIME -> ICU -> peripheral sequence is held
  # in source order. Strict mode is the default; --no-strict downgrades
  # to warn-only.
  if [[ -f scripts/checks/audit_init_order.py ]]; then
    if ! python3 scripts/checks/audit_init_order.py; then
      echo "[FAIL] audit_init_order.py reported per-app init-order"
      echo "       violations. Every examples/<tier>/<app>/main.c must"
      echo "       follow CGC -> MSTP -> IOPORT -> TIME -> ICU ->"
      echo "       peripheral order. Re-run \`make audit-init\` to"
      echo "       refresh docs/INIT_ORDER_AUDIT.md."
      error_found=1
    fi
  fi

  # ---- Doxygen @since tag enforcement -----------------------------------
  if ! python3 scripts/checks/check-since-version.py "${c_file_list[@]}"; then
    echo "[FAIL] public function declarations missing @since tags."
    echo "   Every ra8_* function in a libs/ra8_*/inc/*.h file must have"
    echo "   an @since tag in its preceding Doxygen block."
    error_found=1
  fi

  # ---- Copyright header enforcement -------------------------------------
  if ! python3 scripts/checks/check-copyright.py "${c_file_list[@]}"; then
    echo "[FAIL] missing or wrong copyright/SPDX header."
    error_found=1
  fi

  # ---- nullptr (C23) instead of NULL ------------------------------------
  if ! python3 scripts/checks/check_no_null.py "${c_file_list[@]}"; then
    echo "[FAIL] bare NULL token(s) in code -- replace with C23 nullptr."
    echo "   Allowed: UX_NULL/TX_NULL/FX_NULL/NX_NULL vendor macros,"
    echo "   comments, string literals, third_party trees."
    error_found=1
  fi

  # ---- NASA P10 Rule 4 function-size cap -------------------------------
  # The .clang-tidy LineThreshold=60 only fires when a file actually
  # reaches clang-tidy, and the host tidy-build excludes every
  # cross-compiled translation unit (anything pulling in ThreadX/
  # USBX/NetX or MCU register headers).  This source-level checker
  # closes that gap.  Its scope is derived from git ls-files plus per-file
  # language detection (#359), so it now measures Python and shell functions
  # too, via one parser per language.
  #
  # The selftest is enforced; the tree-wide scan is not yet -- 52 functions are
  # over the cap, all named by running the checker.  See the matching note in
  # scripts/ci/gates/checks.sh; #359 stays open until the scan is uncommented.
  if ! python3 scripts/checks/check_function_size.py --selftest; then
    echo "[FAIL] check_function_size.py selftest failed."
    echo "   A size parser stopped matching; the gate cannot be trusted."
    error_found=1
  fi
  # if ! python3 scripts/checks/check_function_size.py; then
  #   echo "[FAIL] function-size violation(s) above the 60-line cap."
  #   echo "   Extract helpers or hoist tables to file scope to shrink."
  #   error_found=1
  # fi

  # ---- No magic numbers (whole tree) ----------------------------------
  # Same blind-spot story as function-size: clang-tidy's
  # readability-magic-numbers only fires for files in the host
  # compile-db, which contains NO example main.c and silently drops
  # every ARM-only / cross-compiled code path (Helium intrinsics,
  # #ifdef __ARM_* blocks).  That is how `ra8_delay_ms(500U)` reached
  # main.  This source-level checker scans libs/, src/, and example
  # main.c directly (honouring clang-tidy NOLINT waivers).  The tree is
  # clean, so it runs full-tree like check_function_size.py.
  if ! python3 scripts/checks/check_magic_numbers.py; then
    echo "[FAIL] magic number(s) found -- every integer literal must"
    echo "   be a named typed enum (const only for floats; macros are"
    echo "   NOT allowed for constants). Genuine exceptions may carry"
    echo "   a trailing 'MAGIC-OK: <reason>' or a scoped clang-tidy"
    echo "   NOLINT(readability-magic-numbers)."
    error_found=1
  fi

  # ---- no redundant casts inside TEST_ASSERT_EQ --------------------------
  test_files=$(echo "$c_files" | grep -E "^tests/" || true)
  if [[ -n "$test_files" ]] && [[ -f scripts/checks/check_assert_casts.py ]]; then
    mapfile -t test_file_list <<<"$test_files"
    if ! python3 scripts/checks/check_assert_casts.py "${test_file_list[@]}"; then
      echo "[FAIL] redundant cast(s) in TEST_ASSERT_EQ -- run strip_assert_casts.py."
      error_found=1
    fi
  fi

  # ---- cppcheck ----------------------------------------------------------
  if command -v cppcheck &>/dev/null; then
    prod_files=$(echo "$c_files" | grep -vE "^tests/" || true)
    if [[ -n "$prod_files" ]]; then
      mapfile -t prod_file_list <<<"$prod_files"
      if ! cppcheck --enable=warning,style,performance,portability \
        --error-exitcode=1 \
        --suppressions-list=.cppcheck-suppressions \
        --inline-suppr \
        --std=c23 \
        --quiet \
        "${prod_file_list[@]}"; then
        echo "[FAIL] cppcheck violations found."
        error_found=1
      fi
    fi
  else
    echo ""
    echo "WARNING: cppcheck not found -- static analysis SKIPPED."
    echo "   Install: sudo apt install cppcheck"
  fi
fi

# -----------------------------------------------------------------------------
# ALWAYS-ON GATES: run on EVERY commit regardless of staged file types.
# These cover the whole first-party tree (C/C++, Python, shell, config), so
# they live outside the C-files-only block above.  They fail on ANY violation
# -- no grandfathering -- and the language tool gates skip with a notice if the
# tool is absent locally (CI runs them with --require).
# -----------------------------------------------------------------------------
# File-size cap (maintainability): no first-party code file over 1000 lines.
# Scope derived from git ls-files + language detection (#359), so it covers
# Python, shell, CMake, YAML, Make and linker scripts as well as C/C++.
# Honours an in-file @generated / FILE-SIZE-OK waiver marker.
#
# Selftest enforced; the tree-wide scan is not yet -- 8 files are over the cap.
# See the matching note in scripts/ci/gates/checks.sh.
if ! python3 scripts/checks/check_file_size.py --selftest; then
  echo "[FAIL] check_file_size.py selftest failed."
  echo "   The derived scope or the cap logic is broken; verdict untrustworthy."
  error_found=1
fi
# if ! python3 scripts/checks/check_file_size.py; then
#   echo "[FAIL] file-size violation(s) above the 1000-line cap."
#   echo "   Split along responsibilities or extract a shared helper."
#   error_found=1
# fi

# Header placement: a header under a src/ dir must be module-private
# (*_internal.h).  A non-internal src/ header is either a misfiled public
# interface (move to inc/) or an unmarked private one (rename *_internal.h).
if ! python3 scripts/checks/check_header_file_placement.py; then
  echo "[FAIL] src/ header(s) that are not *_internal.h."
  echo "   Move public interfaces to inc/, or rename private ones *_internal.h."
  error_found=1
fi

# Examples must not hand-encode board connector pins: the EK-RA8D2 pinout is a
# board fact owned by libs/ra8_board_ek_ra8d2, not copy-pasted per app (#251).
if ! python3 scripts/checks/check_example_board_pins.py; then
  echo "[FAIL] example(s) hand-encode a board pin as (port << 8 | pin)."
  echo "   Reference the board symbol (k_ra8_board_*_pin_*) instead."
  error_found=1
fi

# No .gitignore directory pattern may match at arbitrary depth. An unanchored
# `build/` hid every directory of that name from git AND from thirteen checkers,
# in complete silence, for the life of the tree (#377).
if ! python3 scripts/checks/check_gitignore_scope.py; then
  echo "[FAIL] unanchored .gitignore directory pattern(s)."
  echo "   Anchor with a leading slash, or scope to the roots that produce it."
  error_found=1
fi

# ra8_core is the foundation layer: it must not include any other lib's header
# (no upward dependency -- see #243).
if ! python3 scripts/checks/check_core_layering.py; then
  echo "[FAIL] ra8_core has an upward include into another lib."
  echo "   Move the shared declaration into ra8_core, or keep the consumer higher up."
  error_found=1
fi

# Trailing newline on every first-party source file (C/C++, Python, shell,
# CMake, YAML, ld).  .clang-format InsertNewlineAtEOF only covers C/C++.
if ! python3 scripts/checks/check_final_newline.py; then
  echo "[FAIL] file(s) missing a trailing newline."
  echo "   Add a single newline at end of file."
  error_found=1
fi

# Every scripts/... path mentioned anywhere in the tree resolves. Those
# references are plain text -- a git mv inside scripts/ breaks doc links, hook
# comments and workflow steps with no build error and no test failure.
if ! python3 scripts/checks/check_script_references.py; then
  echo "[FAIL] unresolved scripts/ path reference(s)."
  echo "   Update the reference, or append 'PATHREF-OK: <reason>' if the path is prose."
  error_found=1
fi

# Python lint + format (ruff) over scripts/, tools/, tests/.
if ! python3 scripts/checks/check_ruff.py; then
  echo "[FAIL] ruff lint/format finding(s)."
  echo "   Fix the finding or run 'ruff format'."
  error_found=1
fi

# Shell lint + format (shellcheck --severity=warning + shfmt).
if ! python3 scripts/checks/check_shell.py; then
  echo "[FAIL] shellcheck/shfmt finding(s)."
  echo "   Fix the finding or run 'shfmt -w -i 2 -ci <file>'."
  error_found=1
fi

# Supply-chain SBOM freshness (T5-09 / T5-14): the committed CycloneDX SBOM
# (docs/sbom/ra8-firmware.cdx.json) must match the vendored libs/third_party/
# tree and the gen_sbom.py registry (version macros, catalogued directories).
if ! python3 scripts/gen/gen_sbom.py --check; then
  echo "[FAIL] SBOM is stale or the SOUP tree drifted from the registry."
  echo "   Update scripts/gen/gen_sbom.py + run 'make sbom' and commit the result."
  error_found=1
fi

# -----------------------------------------------------------------------------
# HUM citations, world tags, roadmap summary
# -----------------------------------------------------------------------------
# cite_check runs STRICT: its cite-VALIDATION pass (malformed cite / unknown
# chapter / page-out-of-range) is clean tree-wide, so any regression blocks the
# commit. check_world_tags now runs STRICT (0 findings tree-wide, #241).
# roadmap_stats runs in --check mode
# (the script itself never edits files in pre-commit; the developer is expected
# to run it without --check to refresh).

# ---- HUM citation validator (strict: cite-validation clean tree-wide) ----
# NOTE: this is the cite-VALIDATION gate (does every existing cite parse and
# point at a real chapter/page?). The complementary cite-COVERAGE pass (does
# every MMIO access HAVE a cite?) is available via --require-cites but is not
# yet gate-clean -- see docs and cite_check.py --help.
if [[ -f scripts/checks/cite_check.py ]]; then
  if ! python3 scripts/checks/cite_check.py --strict; then
    echo "[FAIL] cite_check.py reported issues."
    error_found=1
  fi
fi

# ---- World-tag validator (strict: 0 findings tree-wide, #241) -----
if [[ -f scripts/checks/check_world_tags.py ]]; then
  if ! python3 scripts/checks/check_world_tags.py --strict; then
    echo "[FAIL] check_world_tags.py reported issues."
    error_found=1
  fi
fi

# ---- NSC veneer definitions (strict) ------------------------------
# Every RA8_NSC_VENEER declared in ra8_nsc.h must have a definition; a decl
# with no def is a phantom NS->S trust-boundary entry point.
if [[ -f scripts/checks/check_nsc_veneer_defs.py ]]; then
  if ! python3 scripts/checks/check_nsc_veneer_defs.py; then
    echo "[FAIL] check_nsc_veneer_defs.py reported an undefined NSC veneer."
    error_found=1
  fi
fi

# ---- stub-vs-production crypto guard (strict, #180) ---------------
# Every insecure placeholder-crypto body must be wrapped in the
# RA8_INSECURE_STUB_CRYPTO / RA8_SIMULATOR_MODE guard with a fail-closed #else,
# so a release/HIL image that forgot to swap in real crypto fails closed
# instead of silently shipping the deterministic-TRNG / forgeable-MAC stub.
if [[ -f scripts/checks/check_stub_crypto_guarded.py ]]; then
  if ! python3 scripts/checks/check_stub_crypto_guarded.py; then
    echo "[FAIL] check_stub_crypto_guarded.py: insecure stub crypto is not guarded fail-closed."
    error_found=1
  fi
fi

# ---- No silent stubs -----------------------------------------------
# A function that discards its arguments and hands back a canned answer, so the
# build links and the program claims a capability it does not have. Catches a
# do-nothing second definition of a symbol implemented for real elsewhere
# (SHADOW) and an unsupported-error return with no implementation behind it
# (CANNED). Hardware that does not exist yet is waived by TODO(<named part>).
if [[ -f scripts/checks/check_no_silent_stubs.py ]]; then
  if ! python3 scripts/checks/check_no_silent_stubs.py --selftest >/dev/null; then
    echo "[FAIL] check_no_silent_stubs.py: the detector's own selftest failed."
    error_found=1
  elif ! python3 scripts/checks/check_no_silent_stubs.py; then
    echo "[FAIL] check_no_silent_stubs.py: a silent stub would be committed."
    error_found=1
  fi
fi

# ---- No RA8_SIMULATOR_MODE-guarded asm in a HAL driver (#293) ------
# wfi/dsb/isb/nop/cpsie/cpsid/reset-spin route through the shared seam
# libs/ra8_hal/inc/ra8_hw_intrinsics.h (+ tests/mocks/ra8_host_asm_stub.c), so
# a driver never carries its own #ifdef RA8_SIMULATOR_MODE around inline asm.
if [[ -f scripts/checks/check_no_driver_asm_guard.py ]]; then
  if ! python3 scripts/checks/check_no_driver_asm_guard.py; then
    echo "[FAIL] check_no_driver_asm_guard.py: a HAL driver guards asm on RA8_SIMULATOR_MODE."
    error_found=1
  fi
fi

# ---- ROADMAP summary stats (strict: refuse stale summaries) -------
if [[ -f scripts/report/roadmap_stats.py && -f docs/ROADMAP.md ]]; then
  if ! python3 scripts/report/roadmap_stats.py --check; then
    echo "[FAIL] ROADMAP.md summary block is stale."
    echo "       Run: python3 scripts/report/roadmap_stats.py"
    echo "       Then re-stage docs/ROADMAP.md and re-commit."
    error_found=1
  fi
fi

# -----------------------------------------------------------------------------
# IEC 61508 SIL 3 / DO-178C QUALIFICATION GATES
# -----------------------------------------------------------------------------
# Per CLAUDE.md, this codebase targets IEC 61508 SIL 3 (industry-agnostic) /
# DO-178C Level B / ISO 26262 ASIL C/D. DO-178B is OBSOLETE and must not
# appear in new content. Every test of a compound boolean decision must
# declare its MC/DC vector pattern via @par MC/DC: in Doxygen.

# ---- Forbid obsolete safety-standard references (strict) ----------
if [[ -f scripts/checks/check_obsolete_standards.py ]]; then
  if ! python3 scripts/checks/check_obsolete_standards.py; then
    echo "[FAIL] Obsolete safety-standard reference (DO-178B)."
    echo "       Use DO-178C, IEC 61508 SIL 3, or ISO 26262 instead."
    error_found=1
  fi
fi

# ---- HIL "honest contract" gate ---------------------------------
# Forbid HIL_MODE=alive (without HIL_FAULT_EXPECTED=1) under
# hw_validated/hil/. Apps in that directory must prove the feature
# works on hardware (uart_scrape / usb_cdc / jlink_memprobe /
# hil_eth_tcp). Apps that have no observable signal yet must live
# in hw_pending/ until they are instrumented.
if [[ -f scripts/checks/check_hil_alive_policy.py ]]; then
  if ! python3 scripts/checks/check_hil_alive_policy.py; then
    echo "[FAIL] HIL honest-contract policy violated."
    error_found=1
  fi
fi

# ---- SIM==HIL parity gate ---------------------------------------
# Every hw_validated/hil app must also be exercised in the simulator:
# it must carry a hil.conf, be discovered by sil_all.sh (not just
# hil_all.sh), and declare a HIL_MODE board_sim can check (no SIL
# skips). Cheap structural gate -- re-derives both harnesses' app
# discovery from hil_all.sh / sil_all.sh, so an added HIL app cannot
# silently escape SIM coverage.
if [[ -f scripts/checks/check_hil_sil_parity.py ]]; then
  if ! python3 scripts/checks/check_hil_sil_parity.py; then
    echo "[FAIL] check_hil_sil_parity.py: a HIL app is not SIL-covered."
    error_found=1
  fi
fi

# ---- In-tree line-citation gate (warn in Wave 0) ------------------
# Comments must reference functions/symbols, not `<file>.c:NNN`. Line
# numbers go stale on the next reformat. External citations (HUM,
# FSP, RFC) remain mandatory. See docs/CITATION_POLICY.md and
# scripts/checks/check_line_citations.py.
if [[ -f scripts/checks/check_line_citations.py ]]; then
  if ! python3 scripts/checks/check_line_citations.py; then
    echo "[FAIL] check_line_citations.py reported issues."
    error_found=1
  fi
fi

# ---- C23 [[...]] attribute syntax (no GNU __attribute__) -----------
if [[ -f scripts/checks/check_no_gnu_attribute.py ]]; then
  if ! python3 scripts/checks/check_no_gnu_attribute.py; then
    echo "[FAIL] check_no_gnu_attribute.py: use the C23 [[...]] form."
    error_found=1
  fi
fi

# ---- No silent ra8_err_t discards at TrustZone boot boundaries ----
# A C23 (void)-cast silences [[nodiscard]] by ISO rule, so -Werror can
# never catch `(void)ra8_cgc_init();` right before a BLXNS (T2-05,
# tracker #191). This gate bans (void)-cast discards of the
# ra8_tz_secure_boot_* family everywhere and of any ra8_*() call inside
# a boot TU (a .c defining SystemInit / ra8_trustzone_init).
if [[ -f scripts/checks/check_tz_boundary_discard.py ]]; then
  if ! python3 scripts/checks/check_tz_boundary_discard.py; then
    echo "[FAIL] check_tz_boundary_discard.py: handle the error, do not (void)-cast it."
    error_found=1
  fi
fi

# ---- @par MC/DC: block on staged tests (warn in Wave 0) -----------
if [[ -f scripts/checks/check_mcdc_block.py ]]; then
  if ! python3 scripts/checks/check_mcdc_block.py; then
    echo "[FAIL] check_mcdc_block.py reported issues."
    error_found=1
  fi
fi

# ---- New compound boolean decisions must ship with MC/DC tests ----
# Static gate (no build): for each staged .c file under libs/, src/,
# port/, diff against HEAD and reject any newly added `&&` / `||`
# decision that does not have a `test_mcdc_*` function citing the
# source file:line in a `@par MC/DC:` block under tests/. This is a
# regression-prevention companion to the CI baseline gate -- it stops
# the project-wide MC/DC % from drifting downward one commit at a time.
