#!/usr/bin/env bash
#
# scripts/git/commit-msg -- block AI attribution in commit messages.
#
# Install:
#   ln -s ../../scripts/git/commit-msg .git/hooks/commit-msg
#
# Reads the commit-message file passed by git as $1 and rejects any
# message that adds AI-tool attribution. The project policy in CLAUDE.md
# "AI attribution policy" forbids "Co-Authored-By: Claude", "Generated by
# Claude Code", "Co-Authored-By: Anthropic", "Co-Authored-By: GPT", etc.
#
# Per-commit opt-out: include a literal `AI-OK: <reason>` line in the
# message.
#
# Copyright (c) 2026 Brighton Sikarskie
# SPDX-License-Identifier: MIT

set -euo pipefail

MSG_FILE="${1:-}"
if [[ -z "${MSG_FILE}" || ! -f "${MSG_FILE}" ]]; then
    echo "commit-msg: no message file passed" >&2
    exit 0
fi

# Strip git's auto-comment lines so they cannot trigger us.
PAYLOAD="$(grep -v '^#' "${MSG_FILE}" || true)"

# Per-commit opt-out.
if echo "${PAYLOAD}" | grep -qiE '^[[:space:]]*AI-OK:'; then
    exit 0
fi

VIOLATIONS=()

# Master AI-tool brand list. Add new entries here -- both regex blocks
# below pick them up. The pipe between groups keeps them grouped for the
# Co-Authored-By "Name" position and the prose "Generated by Name"
# position.
AI_BRANDS='(Claude|Anthropic|OpenAI|GPT|ChatGPT|Codex|Copilot|GitHub Copilot|Cursor|Cursor Composer|Aider|Continue|Cody|Sourcegraph Cody|Tabnine|Codeium|Windsurf|Devin|Cognition|Replit|Ghostwriter|CodeWhisperer|Q Developer|Cline|Roo Code|Roo Cline|JetBrains AI|Gemini|Bard|Llama|Mistral|Mixtral|DeepSeek|Qwen|Phind|Perplexity|Pieces|Sweep|Smol|SmolAgents|Phi|Grok|xAI|Inflection|Pi|Character\.AI|Hugging ?Face|Ollama|LM ?Studio|llama\.cpp|Stability AI|Midjourney|DALL-?E|Sora|Runway|Suno)'

if echo "${PAYLOAD}" | grep -qiE "^[[:space:]]*Co-Authored-By:[[:space:]]*${AI_BRANDS}"; then
    VIOLATIONS+=("Co-Authored-By line names an AI tool")
fi
if echo "${PAYLOAD}" | grep -qiE "(Generated|Authored|Created|Written|Refactored|Reviewed|Coded|Implemented) (by|with|using) ${AI_BRANDS}"; then
    VIOLATIONS+=("'<verb> by/with/using <AI>' attribution")
fi
if echo "${PAYLOAD}" | grep -qE '🤖[[:space:]]+(Generated|Created|Authored)[[:space:]]+(with|by)'; then
    VIOLATIONS+=("'robot' AI attribution emoji line")
fi
if echo "${PAYLOAD}" | grep -qiE '\bclaude\.ai\b|\bclaude code\b|\bchatgpt\b|\bcopilot\b|\bcursor\.(sh|com)\b|\bcodeium\b|\bwindsurf\b|\baider\b|\btabnine\b|\bcontinue\.dev\b|\bcody\.dev\b|\bdevin\.ai\b|\breplit ghostwriter\b|\bcodewhisperer\b|\bq developer\b|\bperplexity\.ai\b|\bcline\b'; then
    VIOLATIONS+=("AI tool brand name / domain in message body")
fi

if [[ ${#VIOLATIONS[@]} -eq 0 ]]; then
    exit 0
fi

cat <<EOF >&2
[FAIL] Commit message contains AI attribution. Project policy
       (CLAUDE.md "AI attribution policy") requires zero AI
       attribution in commit messages.

Findings:
EOF
for v in "${VIOLATIONS[@]}"; do
    echo "  - ${v}" >&2
done
cat <<EOF >&2

Per-commit opt-out (rare): add a line "AI-OK: <reason>" to the
commit message and re-run.
EOF
exit 1
