# SHEBANG-SECURITY: -p blocks BASH_ENV and exported-function startup injection.
#
# scripts/git/commit-msg -- enforce commit-message policy: zero AI
# attribution AND inclusive terminology.
#
# Install:
#   ln -s ../../scripts/git/commit-msg .git/hooks/commit-msg
#
# Reads the commit-message file passed by git as $1 and rejects any
# message that (a) adds AI-tool attribution (CLAUDE.md "AI attribution
# policy" -- "Co-Authored-By: Claude", "Generated by Claude Code", etc.)
# or (b) uses non-inclusive legacy terminology (master/slave, MOSI/MISO,
# Slave Select).
#
# Per-commit opt-out: include a literal `AI-OK: <reason>` line (AI check)
# or a per-line `LEGACY-OK: <reason>` (inclusive check).
#
# CI split: set CHECK_ONLY=ai to run ONLY the AI-attribution check, or
# CHECK_ONLY=inclusive for ONLY the inclusive-terminology check. This lets
# each concern be enforced by (and attributed to) its own CI workflow --
# no-ai-attribution.yml runs CHECK_ONLY=ai, inclusive-terminology.yml owns
# the inclusive commit-message gate. The default (unset) runs BOTH, which
# is what the local hook does so a developer sees every problem at commit
# time.
#

if [[ "$-" == *p* ]]; then
  unset -v BASH_ENV ENV
  declare -a ra8_startup_env_unset=()
  _ra8_startup_refuse() {
    printf 'error: privileged startup %s\n' "$1" >&2
    exit 1
  }
  ra8_startup_env_done_count=0
  while IFS= read -r -d '' ra8_startup_env_row; do
    ra8_startup_env_name="${ra8_startup_env_row%%=*}"
    case "$ra8_startup_env_name" in
      RA8_STARTUP_ENV_DONE)
        ra8_startup_env_done_count=$((ra8_startup_env_done_count + 1))
        ;;
      BASH_FUNC_*%% | BASH_FUNC_*'()') ra8_startup_env_unset+=(-u "$ra8_startup_env_name") ;;
    esac
  done < <(
    /usr/bin/env -u RA8_STARTUP_ENV_DONE -0 &&
      /usr/bin/printf 'RA8_STARTUP_ENV_DONE=1\0'
  )
  ((ra8_startup_env_done_count == 1)) && [[ "$ra8_startup_env_name" == RA8_STARTUP_ENV_DONE ]] || _ra8_startup_refuse 'environment enumeration was incomplete'
  if ((${#ra8_startup_env_unset[@]})); then
    [[ -z "${RA8_STARTUP_ENV_SCRUBBED-}" ]] || _ra8_startup_refuse 'scrub did not converge'
    ra8_startup_reentry="$0"
    [[ "$ra8_startup_reentry" == */* ]] || _ra8_startup_refuse 'requires a script path'
    if [[ "$ra8_startup_reentry" != /* ]]; then
      ra8_startup_reentry="$PWD/$ra8_startup_reentry"
    fi
    ra8_startup_check="$ra8_startup_reentry"
    while [[ "$ra8_startup_check" != "/" ]]; do
      [[ ! -L "$ra8_startup_check" ]] || _ra8_startup_refuse 'refuses a symlinked path'
      ra8_startup_parent="${ra8_startup_check%/*}"
      [[ -n "$ra8_startup_parent" ]] || ra8_startup_parent="/"
      [[ "$ra8_startup_parent" != "$ra8_startup_check" ]] ||
        _ra8_startup_refuse 'cannot validate its script path'
      ra8_startup_check="$ra8_startup_parent"
    done
    [[ -f "$ra8_startup_reentry" ]] || _ra8_startup_refuse 'refuses a non-regular path'
    if ! exec /usr/bin/env "${ra8_startup_env_unset[@]}" -u BASH_ENV -u ENV \
      -u RA8_STARTUP_ENV_DONE RA8_STARTUP_ENV_SCRUBBED=1 \
      /bin/bash -p -- "$ra8_startup_reentry" "$@"; then
      _ra8_startup_refuse 'could not enter sanitized process'
    fi
  fi
  unset -v ra8_startup_check ra8_startup_env_done_count
  unset -v ra8_startup_env_name ra8_startup_env_row
  unset -v ra8_startup_env_unset ra8_startup_parent ra8_startup_reentry
  unset -v RA8_STARTUP_ENV_DONE
  unset -v RA8_STARTUP_ENV_SCRUBBED
  unset -f _ra8_startup_refuse

  set -euo pipefail

  if [[ "${1:-}" == "--selftest" ]]; then
    selftest_dir="$(mktemp -d)"
    trap 'rm -rf "$selftest_dir"' EXIT
    printf '%s\n' "firmware: describe the owned change" >"$selftest_dir/clean"
    printf '%s\n' "Generated by ChatGPT" >"$selftest_dir/ai"
    printf '\360\237\244\226 Generated with tooling\n' >"$selftest_dir/robot-ai"
    printf '\360\237\244\226\357\270\217 Generated with tooling\n' >"$selftest_dir/robot-ai-vs16"
    printf '%s\n' "Generated with tooling" >"$selftest_dir/no-robot-ai"
    printf '%s\n' "Generated by ChatGPT" "AI-OK: policy fixture" >"$selftest_dir/waived"
    printf '%s\n' "hardware: rename the master bus" >"$selftest_dir/legacy"

    attack_marker="$selftest_dir/startup-attack"
    bash_env="$selftest_dir/bash-env"
    printf 'printf "bash-env\\n" >>%q\n' "$attack_marker" >"$bash_env"
    failures=0
    BASH_ENV="$bash_env" /bin/bash -c ':'
    if [[ ! -s "$attack_marker" ]]; then
      failures=$((failures + 1))
    fi
    rm -f "$attack_marker"

    export attack_marker
    grep() {
      printf '%s\n' "exported-function" >>"$attack_marker"
      command grep "$@"
    }
    export -f grep
    grep -q firmware "$selftest_dir/clean"
    rm -f "$attack_marker"
    /bin/bash -c 'grep -q firmware "$1"' _ "$selftest_dir/clean"
    if [[ ! -s "$attack_marker" ]]; then
      failures=$((failures + 1))
    fi
    rm -f "$attack_marker"

    BASH_ENV="$bash_env" CHECK_ONLY=ai /bin/bash -p "$0" "$selftest_dir/clean" >/dev/null 2>&1 ||
      failures=$((failures + 1))
    if [[ -e "$attack_marker" ]]; then
      failures=$((failures + 1))
    fi
    unset -f grep
    unset attack_marker

    CHECK_ONLY=ai /bin/bash -p "$0" "$selftest_dir/clean" >/dev/null 2>&1 || failures=$((failures + 1))
    if CHECK_ONLY=ai /bin/bash -p "$0" "$selftest_dir/ai" >/dev/null 2>&1; then
      failures=$((failures + 1))
    fi
    if CHECK_ONLY=ai /bin/bash -p "$0" "$selftest_dir/robot-ai" >/dev/null 2>&1; then
      failures=$((failures + 1))
    fi
    if CHECK_ONLY=ai /bin/bash -p "$0" "$selftest_dir/robot-ai-vs16" >/dev/null 2>&1; then
      failures=$((failures + 1))
    fi
    CHECK_ONLY=ai /bin/bash -p "$0" "$selftest_dir/no-robot-ai" >/dev/null 2>&1 ||
      failures=$((failures + 1))
    CHECK_ONLY=ai /bin/bash -p "$0" "$selftest_dir/waived" >/dev/null 2>&1 || failures=$((failures + 1))
    if CHECK_ONLY=inclusive /bin/bash -p "$0" "$selftest_dir/legacy" >/dev/null 2>&1; then
      failures=$((failures + 1))
    fi
    if COMMIT_IDENTITY="codex[bot] bot@example.invalid" CHECK_ONLY=ai \
      /bin/bash -p "$0" "$selftest_dir/clean" >/dev/null 2>&1; then
      failures=$((failures + 1))
    fi
    mkdir -p "$selftest_dir/fail-bin"
    printf '%s\n' '#!/bin/bash -p' 'exit 2' >"$selftest_dir/fail-bin/grep"
    chmod +x "$selftest_dir/fail-bin/grep"
    if PATH="$selftest_dir/fail-bin:/usr/bin:/bin" CHECK_ONLY=ai \
      /bin/bash -p "$0" "$selftest_dir/clean" >/dev/null 2>&1; then
      failures=$((failures + 1))
    fi
    if [[ "$failures" -ne 0 ]]; then
      echo "commit-msg: selftest failed ($failures case(s))" >&2
      exit 1
    fi
    echo "commit-msg: selftest passed"
    exit 0
  fi

  MSG_FILE="${1:-}"
  if [[ -z "${MSG_FILE}" || ! -f "${MSG_FILE}" ]]; then
    echo "commit-msg: no message file passed" >&2
    exit 0
  fi

  # Which concern(s) to enforce: both (default) | ai | inclusive.
  CHECK_ONLY="${CHECK_ONLY:-both}"

  # Strip git's auto-comment lines so they cannot trigger us.
  set +e
  PAYLOAD="$(grep -v '^#' "${MSG_FILE}")"
  grep_rc=$?
  set -e
  if [[ "$grep_rc" -gt 1 ]]; then
    echo "commit-msg: could not read message file: ${MSG_FILE}" >&2
    exit "$grep_rc"
  fi
  IDENTITY="${COMMIT_IDENTITY:-}"

  # ---- Inclusive terminology in commit message ----------------------
  # Runs unless the caller asked for the AI check only. Per-line opt-out:
  # LEGACY-OK: <reason> on the offending line.
  if [[ "${CHECK_ONLY}" != "ai" ]]; then
    INCL_VIOLATIONS=()
    while IFS= read -r line; do
      # Skip opt-out lines and git comment lines.
      echo "${line}" | grep -qiE '^[[:space:]]*(#|LEGACY-OK:)' && continue
      if echo "${line}" | grep -qiE '\bmaster(s|ed|ing|ship)?\b'; then
        INCL_VIOLATIONS+=("legacy term 'master' in: ${line}")
      fi
      if echo "${line}" | grep -qiE '\bslave(s|d)?\b'; then
        INCL_VIOLATIONS+=("legacy term 'slave' in: ${line}")
      fi
      if echo "${line}" | grep -qE '\bMOSI\b'; then
        INCL_VIOLATIONS+=("legacy term 'MOSI' -- use COPI: ${line}")
      fi
      if echo "${line}" | grep -qE '\bMISO\b'; then
        INCL_VIOLATIONS+=("legacy term 'MISO' -- use CIPO: ${line}")
      fi
      if echo "${line}" | grep -qiE '\bSlave[ _-]Select\b'; then
        INCL_VIOLATIONS+=("legacy term 'Slave Select' -- use CS: ${line}")
      fi
      # Note: bare '\bSS\b' is intentionally omitted -- too many false positives
      # in prose commit messages.  Caught at source-file level instead.
    done <<<"${PAYLOAD}"

    if [[ ${#INCL_VIOLATIONS[@]} -gt 0 ]]; then
      cat <<EOF >&2
[FAIL] Commit message uses non-inclusive terminology.
       Use COPI/CIPO, Controller/Peripheral, CS instead.
       Per-line opt-out: add "LEGACY-OK: <reason>" to that line.

Findings:
EOF
      for v in "${INCL_VIOLATIONS[@]}"; do
        echo "  - ${v}" >&2
      done
      exit 1
    fi
  fi

  # ---- AI attribution in commit message -----------------------------
  # Runs unless the caller asked for the inclusive check only.
  if [[ "${CHECK_ONLY}" != "inclusive" ]]; then
    # Per-commit opt-out.
    if echo "${PAYLOAD}" | grep -qiE '^[[:space:]]*AI-OK:'; then
      exit 0
    fi

    VIOLATIONS=()

    # Canonical AI-tool brand list. Add new entries here -- both regex blocks
    # below pick them up. The pipe between groups keeps them grouped for the
    # Co-Authored-By "Name" position and the prose "Generated by Name"
    # position.
    AI_BRANDS='(Claude|Anthropic|OpenAI|GPT|ChatGPT|Codex|Copilot|GitHub Copilot|Cursor|Cursor Composer|Aider|Continue|Cody|Sourcegraph Cody|Tabnine|Codeium|Windsurf|Devin|Cognition|Replit|Ghostwriter|CodeWhisperer|Q Developer|Cline|Roo Code|Roo Cline|JetBrains AI|Gemini|Bard|Llama|Mistral|Mixtral|DeepSeek|Qwen|Phind|Perplexity|Pieces|Sweep|Smol|SmolAgents|Phi|Grok|xAI|Inflection|Pi|Character\.AI|Hugging ?Face|Ollama|LM ?Studio|llama\.cpp|Stability AI|Midjourney|DALL-?E|Sora|Runway|Suno)'

    if echo "${PAYLOAD}" | grep -qiE "^[[:space:]]*Co-Authored-By:[[:space:]]*${AI_BRANDS}"; then
      VIOLATIONS+=("Co-Authored-By line names an AI tool")
    fi
    if echo "${PAYLOAD}" | grep -qiE "(Generated|Authored|Created|Written|Refactored|Reviewed|Coded|Implemented) (by|with|using) ${AI_BRANDS}"; then
      VIOLATIONS+=("'<verb> by/with/using <AI>' attribution")
    fi
    robot_marker="$(printf '\360\237\244\226')"
    robot_variant="$(printf '\357\270\217')"
    if echo "${PAYLOAD}" |
      grep -qE "${robot_marker}(${robot_variant})?[[:space:]]+(Generated|Created|Authored)[[:space:]]+(with|by)"; then
      VIOLATIONS+=("'robot' AI attribution emoji line")
    fi
    if echo "${PAYLOAD}" | grep -qiE '\bclaude\.ai\b|\bclaude code\b|\bchatgpt\b|\bcopilot\b|\bcursor\.(sh|com)\b|\bcodeium\b|\bwindsurf\b|\baider\b|\btabnine\b|\bcontinue\.dev\b|\bcody\.dev\b|\bdevin\.ai\b|\breplit ghostwriter\b|\bcodewhisperer\b|\bq developer\b|\bperplexity\.ai\b|\bcline\b'; then
      VIOLATIONS+=("AI tool brand name / domain in message body")
    fi
    # AI-bot email-domain checks (Author lines, Co-Authored-By trailers,
    # bare email mentions). Bot-user-suffix checks catch the GitHub
    # convention `<name>[bot]` that AI assistants use to identify
    # themselves as app-installed accounts.
    AI_EMAIL_DOMAINS='@(anthropic\.com|openai\.com|cursor\.(sh|com|so)|codeium\.com|tabnine\.com|aider\.chat|continue\.dev|sourcegraph\.com|perplexity\.ai|mistral\.ai|huggingface\.co|deepseek\.com|x\.ai|character\.ai|stability\.ai|midjourney\.com|runwayml\.com|suno\.ai|jetbrains-ai\.com)\b'
    if printf '%s\n%s\n' "${PAYLOAD}" "${IDENTITY}" | grep -qiE "${AI_EMAIL_DOMAINS}"; then
      VIOLATIONS+=("AI vendor email domain in message")
    fi
    # Any '[bot]' suffix: blocks ALL bot-account authorship, not just AI
    # brand-prefixed ones. Catches github-actions[bot], dependabot[bot],
    # claude[bot], copilot[bot], cursor[bot], etc. uniformly. Per-commit
    # opt-out via 'AI-OK: <reason>' for the rare case where a bot commit
    # is legitimately desired (e.g. a deliberate dependabot SHA bump that
    # the developer is willing to take ownership of).
    if printf '%s\n%s\n' "${PAYLOAD}" "${IDENTITY}" |
      grep -qiE '\[bot\]($|[^[:alnum:]_])'; then
      VIOLATIONS+=("Bot-account suffix '[bot]' in message (any bot, not just AI)")
    fi

    if [[ ${#VIOLATIONS[@]} -gt 0 ]]; then
      cat <<EOF >&2
[FAIL] Commit message contains AI attribution. Project policy
       (CLAUDE.md "AI attribution policy") requires zero AI
       attribution in commit messages.

Findings:
EOF
      for v in "${VIOLATIONS[@]}"; do
        echo "  - ${v}" >&2
      done
      cat <<EOF >&2

Per-commit opt-out (rare): add a line "AI-OK: <reason>" to the
commit message and re-run.
EOF
      exit 1
    fi
  fi

  exit 0
else
  [[ "$-" == *p* ]]
fi
