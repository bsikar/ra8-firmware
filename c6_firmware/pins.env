# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Brighton Sikarskie
#
# pins.env -- single source of truth for the ESP32-C6 wireless co-processor
# firmware: the pinned upstream versions and the RA8-host <-> C6 SPI pin map.
#
# build.sh and flash.sh source this file (KEY=value shell fragment; no shebang,
# not a standalone script). Keep it pure KEY=value so it stays source-able.

# ---- Pinned upstream (esp-hosted-mcu SOUP; see docs/SOUP/esp-hosted.md) ----
ESP_HOSTED_MCU_URL=https://github.com/espressif/esp-hosted-mcu
ESP_HOSTED_MCU_COMMIT=949bb30612747a3bd9e402eda8d01fbfa1f8503e
ESP_HOSTED_MCU_SHORT=949bb30
ESP_HOSTED_MCU_FW_VERSION=2.12.11
ESP_IDF_VERSION=v5.5.4
ESP_TARGET=esp32c6

# ---- SPI transport pin map (ESP32-C6 GPIO numbers) ----
# Inclusive names first, with the Espressif legacy name in parentheses.
#   CS   (Chip Select)                = GPIO0
#   COPI (Controller Out / MOSI)      = GPIO1
#   CIPO (Controller In  / MISO)      = GPIO2
#   SCK  (clock / CLK)                = GPIO3
#   DATA_READY (slave -> host)        = GPIO4
#   HANDSHAKE  (slave -> host)        = GPIO6
#   RESET                             = disconnected (-1)
#
# NOTE: in sdkconfig.defaults the settable leaves are ESP_SPI_HSPI_GPIO_{CS,
# MOSI,MISO,CLK}; the ESP_SPI_GPIO_{CS,MOSI,MISO,CLK} symbols are DERIVED and
# ignored. DATA_READY and HANDSHAKE are directly settable (ESP_SPI_GPIO_*).
C6_PIN_CS=0
C6_PIN_COPI=1
C6_PIN_CIPO=2
C6_PIN_SCK=3
C6_PIN_DATA_READY=4
C6_PIN_HANDSHAKE=6
C6_PIN_RESET=-1

# ---- Flash defaults (proven over the CH343 UART bridge; see flash.sh) ----
C6_FLASH_PORT=/dev/ttyACM1
C6_FLASH_BAUD=460800
C6_FLASH_SIZE=16MB
C6_FLASH_MODE=dio
C6_FLASH_FREQ=80m
