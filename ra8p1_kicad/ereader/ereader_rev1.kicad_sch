		(uuid "023f4914-df49-4ef4-b2e2-f8b0e743c5f5")
	)
	(text "Global supplies: +3V3_MCU and GND.\nCore regulator output MCU_VCORE stays local to the processor power sheet.\n\nRemaining subsystem circuits follow epic #821 and issues #824-#834:\nradio, memory/storage, USB/battery, system rails, display controller,\npanel power, touch, warm/cool lighting, buttons and sensors.\nNo empty subsystem sheets are represented as completed circuits.\n\nFootprint and PCB qualification are deferred by scope."
		(exclude_from_sim no)
		(at 198.12 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1c8a1a1d-5f5f-493a-881c-b63a58841aba")
	)
	(text "Processor schematic development\nPower networks are being implemented from RA8P1-specific references.\nThis revision is not a completed schematic or a fabrication release."
		(exclude_from_sim no)
