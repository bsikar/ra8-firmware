	(text "CMS-010 | SDRAM power and bypass\nVDD and VDDQ share +3V3_MCU (3.0 to 3.6 V).\nC76-C79: 4 x 100 nF for the four VDD pins.\nC80-C87: 8 x 100 nF for the eight VDDQ pins.\nC88: 10 uF local bulk; Cnom = 12 x 0.1 + 10 = 11.2 uF.\nIncluded in the PWR-003 1 mF whole-rail limit.\nEffective C, placement and PDN impedance require qualification."
		(exclude_from_sim no)
		(at 25.4 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
			(href "https://github.com/bsikar/ra8-firmware/blob/design/ereader-circuit/ra8p1_kicad/design/camera_storage_interfaces.md#cms-010-is42s32160f-7tli-pin-and-electrical-contract")
		)
		(uuid "3dfe9a7d-05b9-43c6-b336-a2b76637c897")
	)
	(text "64 MiB SDRAM | ISSI IS42S32160F-7TLI\nPOWER/BYPASS PHASE: signal interface is not yet connected.\nAddress, data, command pulls and source clock link: see CMS-010."
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c56fb1b6-e500-48a9-9717-4018b973208c")
	)
