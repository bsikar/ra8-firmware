# CMake build artifacts
build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# Compiled firmware artifacts
*.elf
*.bin
*.hex
*.map
*.lst
*.su

# Compiler intermediates (object files, archives)
*.o
*.obj
*.a
*.lo
*.la

# OS-level crash dumps (e.g. host-side test executables that segfault
# in the Docker test container land at the repo root). Anchored to the
# repo root so they don't shadow legitimate `core/` directories inside
# vendored trees (libs/third_party/tf-psa-crypto/core, etc.).
/core
/core.*
/vgcore.*

# Test build artifacts
tests/build/
tests/build-cov/
tests/Unity/

# GCC coverage instrumentation
*.gcov
*.gcda
*.gcno
*.gcov.json.gz

# Coverage report outputs (already covered by build/ above; listed
# explicitly so the directory is greppable)
build/host-cov/
build/coverage-html/

# Hardware smoke-test outputs (per-app JLink transcripts and the
# aggregate Markdown summary). Already covered by build/ above; listed
# explicitly so the directory is greppable and scripts/hw_smoke_test.sh
# can document where its artifacts land without surprising anyone.
build/smoke/

# GCC RTL dump files
*.expand

# Doxygen generated output (build/ is already ignored above; listed
# explicitly here so a future change to the build-tree policy still
# keeps the generated HTML out of git).
build/docs/
docs/doxygen/html/
docs/doxygen/xml/
docs/doxygen/latex/
docs/doxygen/*.log
doxygen.log

# Per-page PDF splits of the reference manuals (local browsing aid;
# derived from the committed parent PDFs, 2+ GB if expanded).
docs/reference/ra8d2-datasheet/
docs/reference/ra8d2-hardware-user-manual/
docs/reference/ra8d2-high-temperature-operation/
docs/reference/ra8d2-technical-brief/

# Renesas / vendor IDE artifacts (NOT used here, guarded in case they show up)
.metadata/
.settings/
HardwareDebug/
output/
.project
.cproject
*.launch
ra_cfg.txt
ra_gen/
ra/
ra_cfg/

# Vendored FSP blob trees intentionally preserve upstream "ra/" path layout.
!libs/third_party/fsp_blobs/**/ra/
!libs/third_party/fsp_blobs/**/ra/**

# ARM / Keil / IAR artifacts
*.uvprojx
*.uvoptx
*.ewp
*.eww
*.ewd
Debug/
Release/
Objects/
Listings/

# SEGGER
*.jdebug
*.jlink

# Editors
.vscode/
.idea/
*.swp
*~
*.bak
*.tmp
.DS_Store

# Python / tooling
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Local environment
.env
.env.local
.claude/
