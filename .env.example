# Local rig configuration for the HIL (hardware-in-the-loop) scripts.
#
# Copy this file to .env (which is gitignored) and fill in the values for YOUR
# hardware. Only fill in what you use: the plain `make sim-*` / `make <app>`
# flows need nothing here; the `make hil-*` and `make debug-*` flows read it.
#
#   cp .env.example .env
#
# Nothing maintainer-specific is committed to the tree; the scripts source these
# values at runtime (see scripts/hil/lib/rig_env.sh).

# --- Bench Pi + J-Link probe ------------------------------------------------

# ssh target for the bench Pi that hosts the board (user@host). The HIL suite
# ships hexes to it and flashes over its J-Link. Leave blank if you flash a
# board cabled straight into this machine instead.
PI_HOST=

# On-board J-Link OB serial number. Used to pin the right probe on machines
# with more than one. To find it, plug in the board and run:
#
#   make hil-find-jlink        # or: bash scripts/hil/find_jlink.sh
#
# (It reads the serial from the SEGGER tools, falling back to a USB scan.)
# You can also read it off the "S/N:" line JLinkExe prints on connect, or from
# the emulator picker in Ozone / J-Flash Lite.
JLINK_SN=

# Renesas device name for rfp-cli / J-Link. Rarely changed; leave blank to use
# the default (R7KA8D2KF_CPU0).
JLINK_DEVICE=

# --- Serial consoles --------------------------------------------------------
#
# Normally leave all three blank. The HIL scripts resolve consoles by DEVICE
# IDENTITY under /dev/serial/by-id/ (scripts/hil/lib/tty_resolve.sh), because
# /dev/ttyACM<n> is assignment order: a power cycle renumbers every CDC device
# on the bench, and reads from the wrong one look exactly like a silent board.
#
# Set these only to pin a specific device -- e.g. two J-Link probes attached
# (JLINK_SN above also disambiguates that case), or a host with no
# /dev/serial/by-id namespace at all, such as macOS:
#
#   RA8_CONSOLE_TTY=/dev/cu.usbmodem<your J-Link SN>1
#
# RA8_CONSOLE_TTY  EK-RA8D2 board console (J-Link OB VCOM)
# C6_CONSOLE_TTY   ESP32-C6 CH343 UART bridge (flashing + C6 console)
# FG_CONSOLE_TTY   FortiGate bench-LAN console (FTDI FT232R, infra/network/)
RA8_CONSOLE_TTY=
C6_CONSOLE_TTY=
FG_CONSOLE_TTY=

# --- HIL Tapo smart-plug credentials ----------------------------------------
#
# scripts/hil/tapo_control.py resolves these by preferring a self-hosted OpenBao
# vault and falling back to this .env, so the plugs stay controllable even when
# OpenBao or the k3s cluster is down (see scripts/hil/hil_secrets.py).
#
# To use OpenBao, create a 0600 file at ~/.config/hil/openbao.env (NOT in git)
# holding the AppRole identity and vault address -- never the Tapo secrets:
#   BAO_ADDR=http://<node>:32200
#   ROLE_ID=<approle role id>
#   SECRET_ID=<approle secret id>
#   BAO_APPROLE_PATH=approle   # optional (default)
#   BAO_KV_MOUNT=secret        # optional (default)
#   BAO_SECRET_PATH=ra8d2/tapo # optional (default)
# The vault stores the same six values below at secret/ra8d2/tapo. If that file
# is absent or the vault is unreachable, the values below are used directly.

# TP-Link Tapo account (shared by every plug on the rig)
TAPO_USER=
TAPO_PASS=

# Board plug -- powers the EK-RA8D2 target board.
# Reachable only from the Pi's local network segment.
TAPO_BOARD_IP=
TAPO_BOARD_MAC=

# Pi plug -- powers the Raspberry Pi HIL host.
# Must be reachable from the developer workstation (so the Pi can be
# power-cycled when it is wedged or offline).
TAPO_PI_IP=
TAPO_PI_MAC=
