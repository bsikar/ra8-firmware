# Local hardware configuration for the firmware dev scripts.
#
# Copy this file to .env (which is gitignored) and fill in the values for YOUR
# hardware. Emulator and build recipes need none of these; the
# `just apps::hardware::*` flows read them.
#
#   cp .env.example .env
#   chmod 0600 .env
#
# Nothing maintainer-specific is committed to the tree. Unknown keys are
# ignored, and commands or shell syntax are never evaluated.

# --- J-Link probe ------------------------------------------------------------

# On-board J-Link OB serial number. Used to pin the right probe on machines
# with more than one. To find it, plug in the board and read the "S/N:" line
# JLinkExe prints on connect, or use the emulator picker in Ozone / J-Flash Lite.
JLINK_SN=

# Renesas device name for rfp-cli / J-Link. Rarely changed; leave blank to use
# the default (R7KA8D2KF_CPU0).
JLINK_DEVICE=

# --- Serial consoles ---------------------------------------------------------
#
# Set these only to pin a specific device -- e.g. two J-Link probes attached
# (JLINK_SN above also disambiguates that case), or a host with no
# /dev/serial/by-id namespace at all, such as macOS. Blank means scripts/dev/
# resolves the console by device identity under /dev/serial/by-id/, because
# /dev/ttyACM<n> is assignment order: a power cycle renumbers every CDC device.
#
#   RA8_CONSOLE_TTY=/dev/cu.usbmodem<your J-Link SN>1
#
# RA8_CONSOLE_TTY  EK-RA8D2 board console (J-Link OB VCOM)
# C6_CONSOLE_TTY   ESP32-C6 CH343 UART bridge (flashing + C6 console)
RA8_CONSOLE_TTY=
C6_CONSOLE_TTY=
