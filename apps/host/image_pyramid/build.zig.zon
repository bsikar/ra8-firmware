.{
    .name = .image_pyramid,
    .version = "0.1.0",
    .fingerprint = 0x765e0a95a16e11bc,
    .minimum_zig_version = "0.14.1",
    .dependencies = .{
        // Shared host-target selection (see tools/zig_build/macos_host.zig, RA8FW-330).
        .ra8_zig_build = .{ .path = "../../../tools/zig_build" },
        // The JPEG encoder is Zig, so it is linked as an archive
        // rather than compiled from C sources here.
        .ra8_jpeg = .{ .path = "../../../libs/ra8_jpeg" },
        // ra8_log is Zig, so ra8_core arrives as an archive too.
        .ra8_core = .{ .path = "../../../libs/ra8_core" },
        // Turns ra8_jpeg_sw.h into the module src/codec.zig uses.
        .translate_c = .{
            .url = "git+https://codeberg.org/ziglang/translate-c#875969d3493e245e01bf5d7860f792d8f3eb9ef5",
            .hash = "translate_c-0.0.0-Q_BUWoFOBwAhz77Zd15HCVuhTKzdUKc94kezmCeJ7IC_",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
    },
}
