.{
    .name = .image_pyramid,
    .version = "0.1.0",
    .fingerprint = 0x765e0a95a16e11bc,
    .minimum_zig_version = "0.14.1",
    .dependencies = .{
        // Shared host-target selection (see tools/zig_build/macos_host.zig, #899).
        .ra8_zig_build = .{ .path = "../../../tools/zig_build" },
        // The JPEG encoder is Zig as of #2795, so it is linked as an archive
        // rather than compiled from C sources here.
        .ra8_jpeg = .{ .path = "../../../libs/ra8_jpeg" },
        // ra8_log is Zig as of #2836, so ra8_core arrives as an archive too.
        .ra8_core = .{ .path = "../../../libs/ra8_core" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
    },
}
