# Managed by Ansible (infra/ansible/roles/lab_cache)
CacheDir: /var/cache/apt-cacher-ng
LogDir: /var/log/apt-cacher-ng
Port: {{ lab_cache_apt_port }}
BindAddress: {{ lab_cache_bind_address }}
Remap-debrep: file:deb_mirror*.gz /debian ; file:backends_debian
Remap-uburep: file:ubuntu_mirrors /ubuntu ; file:backends_ubuntu
Remap-secdeb: security.debian.org ; security.debian.org
Remap-secubu: security.ubuntu.com ; security.ubuntu.com
ReportPage: acng-report.html
UnbufferLogs: 0
VerboseLog: 1
ExThreshold: 30
PassThroughPattern: .*
