--- a/src/utils/utils.c
+++ b/src/utils/utils.c
@@ -19,6 +19,19 @@
 #include "src/utils/palette.h"
 #include "src/webp/encode.h"
 
+// *** RA8 LOCAL PATCH (docs/SOUP/libwebp.md) BEGIN ***
+// The RA8D2 firmware has no heap (`_sbrk` traps after init). When built with
+// -DRA8_WEBP_USE_ARENA, WebPSafe{Malloc,Calloc,Free} below are routed through
+// the caller-bound bump arena in apps/shared_libs/webp (ra8_webp_arena_*) instead of
+// libc malloc/calloc/free, so a WebP decode reaches no heap (NASA Power-of-10
+// Rule 3). Without the flag (host tooling that has no arena bound), the
+// unmodified libc path is used. Every patched line below is tagged
+// "RA8 LOCAL PATCH".
+#if defined(RA8_WEBP_USE_ARENA)
+#include "ra8_webp_arena.h"
+#endif
+// *** RA8 LOCAL PATCH END ***
+
 // If PRINT_MEM_INFO is defined, extra info (like total memory used, number of
 // alloc/free etc) is printed. For debugging/tuning purpose only (it's slow,
 // and not multi-thread safe!).
@@ -196,7 +209,11 @@
   Increment(&num_malloc_calls);
   if (!CheckSizeArgumentsOverflow(nmemb, size)) return NULL;
   assert(nmemb * size > 0);
+#if defined(RA8_WEBP_USE_ARENA)
+  ptr = ra8_webp_arena_malloc((size_t)(nmemb * size));  // RA8 LOCAL PATCH (docs/SOUP/libwebp.md)
+#else
   ptr = malloc((size_t)(nmemb * size));
+#endif
   AddMem(ptr, (size_t)(nmemb * size));
   return ptr;
 }
@@ -206,7 +223,11 @@
   Increment(&num_calloc_calls);
   if (!CheckSizeArgumentsOverflow(nmemb, size)) return NULL;
   assert(nmemb * size > 0);
+#if defined(RA8_WEBP_USE_ARENA)
+  ptr = ra8_webp_arena_calloc((size_t)nmemb, size);  // RA8 LOCAL PATCH (docs/SOUP/libwebp.md)
+#else
   ptr = calloc((size_t)nmemb, size);
+#endif
   AddMem(ptr, (size_t)(nmemb * size));
   return ptr;
 }
@@ -216,7 +237,11 @@
     Increment(&num_free_calls);
     SubMem(ptr);
   }
+#if defined(RA8_WEBP_USE_ARENA)
+  ra8_webp_arena_free(ptr);  // RA8 LOCAL PATCH (docs/SOUP/libwebp.md)
+#else
   free(ptr);
+#endif
 }
 
 // Public API functions.
