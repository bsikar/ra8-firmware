//
// doxygen_dirs.dox -- one-line descriptions for the top-level directories.
//
// This is the ONLY hand-maintained organization file: the docs otherwise
// mirror the repository layout automatically (every file in INPUT appears in
// the directory tree with no per-file bookkeeping). Adding a driver, example,
// or script needs no edit here; only a NEW top-level directory does.

/*
 * NOTE: the repo-root @dir libs, @dir port, and @dir scripts descriptions live
 * in the generated docs/generated/nav_dirs.dox (emitted by
 * scripts/gen/gen_doxygen_nav.py with path-qualified names). Plain top-level
 * names are ambiguous when Doxygen can also suffix-match a nested directory
 * (for example apps/shared_libs, apps/shared_libs/rabook_import, or an
 * app-local scripts directory).
 */

/**
 * @dir docs
 * @brief Human-facing documentation: architecture, policy, the DO-178C /
 *        IEC 61508 safety-and-certification evidence, hardware bring-up, and
 *        quick reference. The narrative pages are grouped for reading under the
 *        "Guides & Reference" section of the sidebar; this Files view is the
 *        raw on-disk tree. Vendored theme assets (docs/doxygen_theme) and the
 *        legacy build output (docs/doxygen) are excluded.
 */

/**
 * @dir docs/reference
 * @brief Committed vendor reference material: the RA8D2 datasheet, Hardware
 *        User's Manual, technical brief, and the EK-RA8D2 board manual (PDFs),
 *        plus the chapter map used by the HUM-citation tooling.
 */

/**
 * @dir examples
 * @brief Example applications -- the primary showcase of the repository. Each
 *        app pairs the drivers above with its own boot files and linker script
 *        to demonstrate one capability, and is the main entry point for reading
 *        the codebase. Organized by hardware-validation tier (see below).
 */

/**
 * @dir examples/ek_ra8d2/hw_validated
 * @brief Apps confirmed working on a stock EK-RA8D2 board: smoke (no-UART),
 *        uart (print over SCI), manual (jumper/button steps), and hil
 *        (hardware-in-the-loop, driven by the bench rig).
 */

/**
 * @dir examples/ek_ra8d2/hw_pending
 * @brief Apps written but not yet hardware-validated on a stock board.
 */

/**
 * @dir examples/_unsupported
 * @brief Apps that need external hardware not on the stock board (motor driver,
 *        audio CODEC, BLE/Thread radios, ...).
 */

/**
 * @dir examples/ra8p1_foundation
 * @brief Foundation apps for the RA8P1 variant (RA8D2 + Ethos-U55 NPU).
 */

/**
 * @dir coprocessor
 * @brief Firmware for the companion co-processors, built by their own vendor
 *        toolchains rather than this tree's: today the ESP32-C6 esp-hosted
 *        peripheral image that libs/ra8_c6link talks to over SPI.
 */

/**
 * @dir tools
 * @brief Host-side tools: the ra8_emulator RA8D2 emulator, cache/glyph benchmarks,
 *        the EPUB/book image builders, the root-of-trust signer, and the MCP
 *        server.
 */
