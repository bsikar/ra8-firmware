{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "RA8: build selected CMake target",
      "command": "build",
      "preset": "${command:cmake.activeBuildPresetName}",
      "targets": [
        "${command:cmake.launchTargetName}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "RA8: prepare selected firmware",
      "dependsOrder": "sequence",
      "dependsOn": [
        "RA8: build selected CMake target"
      ],
      "problemMatcher": []
    },
    {
      "label": "RA8: build emulator",
      "type": "shell",
      "command": "/bin/bash",
      "args": [
        "-p",
        "${workspaceFolder}/scripts/dev/run_just.sh",
        "tools::build_one",
        "ra8_emulator"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "RA8: prepare emulator session",
      "dependsOrder": "sequence",
      "dependsOn": [
        "RA8: build selected CMake target",
        "RA8: build emulator"
      ],
      "problemMatcher": []
    }
  ]
}
