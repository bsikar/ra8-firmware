{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsikar/ra8d2-firmware/tools/ra_qe/config.schema.json",
  "title": "ra8d2-firmware QE configurator schema",
  "description": "JSON DSL describing clocks, pinmux, irqs, and mstp for an RA8D2 application. Consumed by tools/ra_qe/generate.py to emit hand-written-style C tables (gen_clocks, gen_pinmux, gen_irq, gen_mstp).",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "clocks", "pinmux", "irqs", "mstp"],
  "properties": {
    "app": {
      "type": "string",
      "description": "Short identifier for the target app, used as a comment header and in generated symbol prefixes.",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "description": "Free-form description placed in the generated file header."
    },
    "clocks": {
      "type": "object",
      "description": "Clock-tree configuration. Mirrors the SCKDIVCR / PLLCCR / SCKSCR registers.",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "description": "Primary clock source after ra_cgc_init().",
          "enum": ["moco", "hoco", "loco", "main_osc", "sub_osc", "pll1", "pll2"]
        },
        "hoco_hz": { "type": "integer", "minimum": 0 },
        "moco_hz": { "type": "integer", "minimum": 0 },
        "main_osc_hz": { "type": "integer", "minimum": 0 },
        "pll1_multiplier": { "type": "number", "minimum": 0 },
        "pll1_divider": { "type": "integer", "minimum": 1 },
        "cpuclk0_hz": { "type": "integer", "minimum": 0 },
        "iclk_hz": { "type": "integer", "minimum": 0 },
        "pclka_hz": { "type": "integer", "minimum": 0 },
        "pclkb_hz": { "type": "integer", "minimum": 0 }
      }
    },
    "pinmux": {
      "type": "array",
      "description": "Ordered list of pin configurations. Each entry becomes one row in the generated ra_gpio init table.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["port", "pin", "mode"],
        "properties": {
          "label": {
            "type": "string",
            "description": "Short human label, e.g. 'led_blue' or 'sci0_txd'. Becomes a typed enum value if present."
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11,
            "description": "Port index (0..11) -- maps to k_ra_port_<n>."
          },
          "pin": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15,
            "description": "Pin index within the port (0..15)."
          },
          "mode": {
            "type": "string",
            "enum": ["output", "input", "input_pullup", "peripheral", "analog"],
            "description": "Direction / function of the pin."
          },
          "initial_level": {
            "type": "string",
            "enum": ["low", "high"],
            "description": "Output drive level at init time. Ignored for non-output modes."
          },
          "peripheral": {
            "type": "string",
            "description": "PFS peripheral function name (e.g. 'sci0_txd'). Required when mode == peripheral."
          }
        }
      }
    },
    "irqs": {
      "type": "array",
      "description": "ICU vector / NVIC enable list. Each entry generates one row in the generated IRQ table.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "vector", "priority"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Symbolic event name, e.g. 'sci0_txi'. Becomes a typed-enum entry.",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "vector": {
            "type": "integer",
            "minimum": 0,
            "maximum": 95,
            "description": "ICU vector slot index (0..95 for RA8D2)."
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15,
            "description": "NVIC priority (0 = highest, 15 = lowest)."
          },
          "handler": {
            "type": "string",
            "description": "ISR symbol name. Defaults to '<name>_isr' when omitted.",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "mstp": {
      "type": "array",
      "description": "Module-stop releases. Each entry releases (or stops) a peripheral via MSTPCRA/B/C/D/E.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "enable"],
        "properties": {
          "module": {
            "type": "string",
            "description": "Module identifier, e.g. 'ioport', 'sci0', 'gpt0', 'iic0', 'usbfs', 'cgc'.",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "enable": {
            "type": "boolean",
            "description": "true -> clear MSTP bit (bring module out of stop). false -> set MSTP bit (place in stop)."
          }
        }
      }
    }
  }
}
