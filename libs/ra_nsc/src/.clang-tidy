---
# NSC veneers are forwarding functions: they validate the cross-world
# pointer with RA_NSC_CHECK_NS_RANGE_RW and then hand it off to the
# underlying secure-side driver, which writes through it. The veneer
# itself never touches *out, so clang-tidy's
# readability-non-const-parameter -- which only sees writes inside the
# function body, not through callees -- always fires on these files.
# Disable just for this directory rather than NOLINT every signature.
InheritParentConfig: true
Checks: '-readability-non-const-parameter'
