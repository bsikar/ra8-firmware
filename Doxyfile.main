# Doxyfile.main -- Doxygen configuration for ra8-firmware
#
# Usage:
#   doxygen Doxyfile.main
# Output lands in docs/doxygen/html/ and can be opened directly in a
# browser. The `make docs` target (if present) wraps this.
#
# Copyright (c) 2026 Brighton Sikarskie
# SPDX-License-Identifier: MIT

PROJECT_NAME           = "ra8-firmware"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "Bare-metal firmware for the Renesas RA8D2 MCU group (EK-RA8D2)"

OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
INLINE_INHERITED_MEMB  = YES
FULL_PATH_NAMES        = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
TAB_SIZE               = 2
OPTIMIZE_OUTPUT_FOR_C  = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = YES
RESOLVE_UNNAMED_PARAMS = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO

CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = YES
FORCE_LOCAL_INCLUDES   = NO
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_BY_SCOPE_NAME     = NO
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"

INPUT                  = README.md \
                         src \
                         libs/ra_core \
                         libs/ra_hal \
                         libs/ra_net_pal \
                         libs/ra_usb_pal \
                         libs/ra_nsc \
                         docs/reference/README.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE                = build \
                         build/tidy \
                         tests/build \
                         docs/doxygen
EXCLUDE_SYMLINKS       = YES
EXCLUDE_PATTERNS       = */build/* */_deps/* */tests/build/*
EXAMPLE_PATH           =
IMAGE_PATH             =

USE_MDFILE_AS_MAINPAGE = README.md

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES
VERBATIM_HEADERS       = YES

ALPHABETICAL_INDEX     = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
ENUM_VALUES_PER_LINE   = 1

GENERATE_LATEX         = NO
USE_MATHJAX            = YES
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = libs/ra_core/inc libs/ra_hal/inc libs/ra_net_pal/inc libs/ra_usb_pal/inc libs/ra_nsc/inc src/inc
PREDEFINED             = __DOXYGEN__=1 \
                         __attribute__(x)=

HAVE_DOT               = NO

SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
