# Doxyfile -- Doxygen configuration for ra8-firmware
#
# Usage:
#   doxygen Doxyfile
# or, preferred:
#   bash scripts/builders/docs.sh [--open]
# or:
#   make docs
#
# Output lands in build/docs/html/ and can be opened directly in a
# browser (e.g. open build/docs/html/index.html).
#
# The docs build is pinned to ONE doxygen release (resolved by
# scripts/builders/provision_doxygen.sh): docs/doxygen_theme/header.html is a
# template generated by exactly that version, and any other version leaves
# its unknown $placeholders unexpanded in every published page. Do not build
# this file with an unpinned doxygen; use `make docs`.
#
# Copyright (c) 2026 Brighton Sikarskie
# SPDX-License-Identifier: MIT

PROJECT_NAME           = "ra8-firmware"
# Expanded from the top-level VERSION file by scripts/builders/docs.sh, so a
# version bump there propagates here without a second edit.
PROJECT_NUMBER         = $(RA8_PROJECT_VERSION)
PROJECT_BRIEF          = "Bare-metal firmware for the Renesas RA8 family (RA8D2 / RA8P1)"

OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
INLINE_INHERITED_MEMB  = YES
# Repo-relative file names: dozens of files share a basename (README.md,
# main.c, vector_table.c, ...), and relative paths keep hover titles from
# leaking the absolute path of whichever machine built the docs.
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
TAB_SIZE               = 2
OPTIMIZE_OUTPUT_FOR_C  = YES

# Collapse each markdown page (the README main page especially) to a SINGLE
# treeview node. At the default (5) doxygen turns every markdown heading into a
# child nav node, so README.md's "Getting started / Examples / Development /
# ..." H2s exploded into six sidebar entries. 0 keeps those headings rendered
# ON the page (they still anchor and show in the body) but stops them becoming
# navigation nodes -- the sidebar mirrors the file/directory tree, not each
# page's internal outline. No page here uses an explicit [TOC], so nothing else
# is affected.
TOC_INCLUDE_HEADINGS   = 0

# Per task spec: extract everything (incl. statics) but skip privates.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_METHODS  = YES
# The only anonymous namespaces here are C++ file-local helpers in a couple of
# host tools; they are true internals and would otherwise clutter the C
# firmware's Data Structures list, so leave them out.
EXTRACT_ANON_NSPACES   = NO
RESOLVE_UNNAMED_PARAMS = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO

CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = YES
FORCE_LOCAL_INCLUDES   = NO
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_BY_SCOPE_NAME     = NO
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
# The only "namespaces" in this C firmware are C++ anonymous namespaces in a
# few host tools and the Python helper scripts (parsed via EXTENSION_MAPPING).
# They are internal noise for an API browser -- ~140 namespaces / ~2300 members
# that would otherwise flatten into the sidebar -- so drop the Namespaces tab
# entirely. The scripts and tools remain browsable under Files.
SHOW_NAMESPACES        = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = build/docs/doxygen-warnings.log

# INPUT covers everything first-party so the docs mirror the repo layout and
# stay self-maintaining: new drivers / examples / scripts appear automatically
# in the directory tree with no doc edits.
#
# The site's information architecture is directory/generation-driven:
#   - docs/           : the hand-written docs/*.md pages (grouped into the
#                       "Guides & Reference" tree by docs/generated/nav_docs.dox).
#   - docs/generated/ : the two GENERATED nav trees (see scripts/gen/
#                       gen_doxygen_nav.py, run by build_docs.sh before doxygen)
#                       that group the docs pages and index every example app.
#   - docs/doxygen_dirs.dox : one @dir description per top-level directory (the
#                       Files tab); docs/DoxygenLayout.xml curates the tab order.
INPUT                  = README.md \
                         docs \
                         libs \
                         src \
                         examples \
                         scripts \
                         tools
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c *.h *.cpp *.hpp *.md *.dox *.py *.sh
# Shell has no native doxygen parser; treat it as Python so the leading
# `#` comment header of each script is picked up instead of being skipped.
EXTENSION_MAPPING      = sh=Python
RECURSIVE              = YES

# Curated tab order / visibility for the navigation sidebar.
LAYOUT_FILE            = docs/DoxygenLayout.xml

# EXCLUDE: vendored libs, build trees, and the vendored doxygen-awesome theme
# (its LICENSE/CSS/JS are not first-party docs). docs/doxygen is the legacy
# Doxyfile.main output tree.
EXCLUDE                = libs/third_party \
                         build \
                         tests/build \
                         docs/doxygen \
                         docs/doxygen_theme
EXCLUDE_SYMLINKS       = YES
EXCLUDE_PATTERNS       = */build/* \
                         */build-*/* \
                         */CMakeFiles/* \
                         */__pycache__/* \
                         */_deps/* \
                         */tests/build/* \
                         */third_party/*

EXAMPLE_PATH           =
IMAGE_PATH             =

# Markdown is written for github.com first; the filter maps GitHub idioms
# to their docs-site equivalent at build time: GitHub Actions badges are
# dropped (the repo is private, so badge URLs 404 for site visitors) and
# <dir>/README.md links become @ref <dir> (same target page, without the
# absolute-build-path tooltip doxygen emits for raw .md targets). See the
# filter's docstring for details.
FILTER_PATTERNS        = *.md="python3 scripts/gen/doxygen_md_filter.py"

USE_MDFILE_AS_MAINPAGE = README.md

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES
VERBATIM_HEADERS       = YES

ALPHABETICAL_INDEX     = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html

# doxygen-awesome-css v2.4.2 theme (vendored under docs/doxygen_theme/, MIT)
# with a built-in light/dark toggle next to the search box. HTML_COLORSTYLE
# must be LIGHT; the theme's JS handles the dark switch. header.html is the
# pinned doxygen's default template (doxygen -w html) plus the theme's script
# includes -- regenerate it whenever the doxygen pin moves (see docs/DOCS.md).
# See docs/doxygen_theme/LICENSE.
HTML_HEADER            = docs/doxygen_theme/header.html
HTML_EXTRA_STYLESHEET  = docs/doxygen_theme/doxygen-awesome.css \
                         docs/doxygen_theme/doxygen-awesome-sidebar-only.css \
                         docs/doxygen_theme/doxygen-awesome-sidebar-only-darkmode-toggle.css
HTML_EXTRA_FILES       = docs/doxygen_theme/doxygen-awesome-darkmode-toggle.js \
                         docs/doxygen_theme/doxygen-awesome-fragment-copy-button.js \
                         docs/doxygen_theme/doxygen-awesome-paragraph-link.js
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
ENUM_VALUES_PER_LINE   = 1

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

# Render \f$ formulas client-side; a latex toolchain is never required on
# the machine that builds the docs.
USE_MATHJAX            = YES

MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = libs/ra8_core/inc \
                         libs/ra8_hal/inc \
                         libs/ra8_net_pal/inc \
                         libs/ra8_usb_pal/inc \
                         libs/ra8_nsc/inc
PREDEFINED             = __DOXYGEN__=1 \
                         __attribute__(x)=

# Graphviz-driven diagrams. The build_docs.sh wrapper flips HAVE_DOT off
# automatically when `dot` is not on PATH so the build still succeeds.
# Per-function call/caller graphs are disabled: across the whole first-party
# tree they generate tens of thousands of SVGs (~0.5 GB), which is impractical
# to publish. Include / collaboration / directory graphs (far fewer) stay on.
HAVE_DOT               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_GRAPH_MAX_NODES    = 75
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES

SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

# Generated by scripts/gen/gen_doxygen_nav.py (run by build_docs.sh before
# doxygen). Supplies EXCLUDE_SYMBOLS = <first-party Python tooling modules> so
# their classes do not pollute the C firmware's Data Structures list. If it is
# absent (e.g. a raw `doxygen Doxyfile` without `make docs`), doxygen just warns
# and proceeds -- the docs still build.
@INCLUDE_PATH          = docs/generated
@INCLUDE               = nav_config.doxy
