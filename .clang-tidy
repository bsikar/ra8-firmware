---
# ra8-firmware - clang-tidy configuration
#
# Run against the host-compiled test build (tests/build/compile_commands.json)
# because the cross-compiler (arm-none-eabi-gcc) emits Cortex-M85-specific
# flags that LLVM cannot always parse cleanly. All firmware source files are
# compiled into the test build via standard gcc/clang, so full coverage is
# achieved.
#
# Minimum clang version: 16 (required for C23 typed enum syntax).
# Ubuntu 24.04 ships clang-18 via the unversioned 'clang-tidy' package.
#
# Usage:
#   cmake -B build/tidy -S tests/ -DENABLE_CLANG_TIDY=ON
#   cmake --build build/tidy
#
# Or via script:
#   bash scripts/checks/clang_tidy.sh --check

#
# Disabled checks (each line carries the rationale for why it is off,
# verified by re-enabling the check and counting real violations):
#
#  -bugprone-easily-swappable-parameters     (137 violations)
#      Fires on every `(uint8_t channel, uint8_t pin)` HAL signature.
#      Eliminating means wrapping each pair in a typed struct -- API
#      churn for marginal safety gain on register-index parameters.
#  -misc-include-cleaner                      (156 violations)
#      Flags umbrella headers like `ra8_regs.h` that re-export every
#      per-peripheral regs header for convenience, plus `ra8_check.h`
#      re-exporting `ra8_err.h`. The pattern is intentional.
#  -performance-no-int-to-ptr                 (179 violations)
#      Every MMIO accessor *is* an int-to-pointer cast:
#      `(volatile T*)0x40080000`. Fundamental to bare-metal register
#      access; cannot be eliminated without abandoning the HAL pattern.
#  -portability-avoid-pragma-once             (clang-tidy v22)
#      The project mandates `#pragma once` (CLAUDE.md "Header Guards").
#      v18 doesn't fire this on our headers; v22 does. Disable so the
#      Homebrew/macOS pre-commit run agrees with CI.
#  -clang-analyzer-core.FixedAddressDereference  (clang-tidy v22)
#      Dereferencing fixed MMIO addresses is the whole point of the
#      HAL. v18 doesn't surface this on our register access patterns;
#      v22 does, throughout libs/ra8_hal/, libs/ra8_core/, and the
#      per-app boot files. Disable globally.
#  -misc-use-internal-linkage                  (clang-tidy v22)
#      Flags vector-table entries (Reset_Handler, Default_Handler,
#      SystemInit, _sbrk, IRQ handlers) as if they should be `static`,
#      breaking the linker's external resolution. v18 doesn't fire on
#      these; v22 does. Disable globally.
#  -readability-identifier-length             (style check, not a
#                                              defect check)
#      Enforces fixed minimum identifier lengths (3 for variables and
#      parameters, 2 for loop counters). docs/STYLE_GUIDE.md's Naming
#      section governs prefixes and case and is silent on length, so
#      the short names it permits are pervasive here: measured over
#      the first-party C surface enumerated by lint_targets.py c,
#      1575 single-character parameters of builtin type across 428
#      files, led by y/x/s/n/w/h/v/p -- geometry, counts, byte
#      cursors and comparator pairs -- plus every loop counter and
#      short local the check also governs. Adopting the rule is a
#      whole-tree renaming decision, not a per-site waiver, and no
#      CheckOptions setting expresses the exception without becoming
#      an allowlist as broad as the exclusion itself. The check
#      reports no defect it would otherwise find: it is purely a
#      length rule.
#  -readability-implicit-bool-conversion      (~120 spurious
#                                              auto-fixes in v18)
#      C/C++ semantic mismatch in clang-tidy 18: relational operators
#      like `==`, `!=`, `<` produce `int` in C (per C standard) rather
#      than `bool`, so the check fires on idiomatic `return x != y;`
#      bodies. Its auto-fixer wraps them in `(x != y) != 0`, which
#      is identical noise. v22 doesn't flag the same code at all.
#  -clang-analyzer-optin.core.EnumCastOutOfRange  (376 violations, none of
#                                                  them reachable defects)
#      Models the C++ rule that converting an out-of-enumerator value to a
#      *scoped* enum is undefined. It is not undefined here: CLAUDE.md
#      mandates that every enum in this tree declare an explicit underlying
#      type (`typedef enum : uint8_t`), and C23 6.7.2.2 makes conversion of
#      any value representable in that fixed underlying type well-defined.
#      What the check actually flags is (a) the negative tests -- passing
#      `(ra8_ipc_core_id_t)0xFFU` is the only way to prove a driver rejects a
#      bogus enum argument, and it is precisely what the test exists to do --
#      and (b) the flag-enum idiom
#      `(ra8_psa_key_usage_t)(k_..._encrypt | k_..._decrypt)`, whose OR is a
#      valid bit pattern rather than a named enumerator. Neither can be
#      rewritten without deleting the test or inventing production
#      enumerators that exist only to satisfy the analyzer.
#  -clang-analyzer-valist.Unterminated,
#  -clang-analyzer-valist.Uninitialized,
#  -clang-analyzer-valist.CopyToSelf            (whole family:
#                                               path-non-deterministic, guards
#                                               no real finding here)
#      The clang-18 valist family is path-non-deterministic in this tree: it
#      reports phantom "va_list is leaked / uninitialized" findings against
#      functions that contain no va_list at all -- observed .Unterminated on
#      reflow_render.c and .Uninitialized as 0->15 on
#      tests/hal/src/test_ra8_rtc.c
#      -- failing one CI run and passing the next on byte-identical code (each
#      cost a full-suite FAIL and a bisect to attribute). The only real va_list
#      code in the tree, port/esp-hosted/src/ra8_esp_hosted_{osi,fmt}.c, draws
#      ZERO findings from any member (none appear in .github/tidy-baseline.txt),
#      so what this family produces here is exclusively non-deterministic noise,
#      not signal. Disable all three -- CopyToSelf pre-emptively, so it cannot
#      flake later the way its siblings already have.
#
#  -readability-redundant-casting             (tool-version inconsistent)
#      Flags explicit casts that document register widths and signedness in
#      some clang-tidy majors but not others. Those casts are required by the
#      project MISRA conversion rules; removing them would trade a safety
#      contract for a cosmetic diagnostic whose result changes by tool major.
#  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#      Flags every memcpy/memset call and prescribes the optional C11 Annex K
#      *_s interfaces. Newlib does not provide Annex K, and each first-party
#      call supplies an explicit bounded length already checked by the normal
#      buffer and size rules. There is no portable replacement API on the
#      target, so this diagnostic is not actionable.
Checks: >
  cert-*,
  bugprone-*,
  clang-analyzer-*,
  misc-*,
  readability-*,
  portability-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-core.FixedAddressDereference,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-valist.Unterminated,
  -clang-analyzer-valist.Uninitialized,
  -clang-analyzer-valist.CopyToSelf,
  -misc-include-cleaner,
  -misc-use-internal-linkage,
  -performance-no-int-to-ptr,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-redundant-casting,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

# ALL warnings are errors -- zero tolerance for any clang-tidy violation.
WarningsAsErrors: '*'

# Ordinary authored headers are direct lint inputs. Only the exact textual
# fragments that cannot parse as standalone translation units are reported
# through their owning includers. scripts/checks/tidy/collect.sh owns this
# 27-path manifest; the tidy selftest proves this POSIX ERE is its exact mirror
# and admits no ordinary, generated, system, or vendored header.
HeaderFilterRegex: '(^|.*/)(apps/board/stand_alone/ereader/tests/inc/test_ra8_manga_stream\.h|apps/shared_libs/epub/src/epub_xml_opf_internal\.h|apps/shared_libs/epub/src/epub_xml_toc_internal\.h|apps/shared_libs/mdl/tests/inc/test_mdl_fetch_fixture\.h|apps/shared_libs/reflow/tests/inc/reflow_v1_test_util\.h|apps/shared_libs/unarch/tests/inc/unarch_tar_fixture\.h|apps/shared_libs/xml/src/xml_reader_internal\.h|libs/if_ra8_vfs/src/fw_if_fs_ra8_vfs_contracts_internal\.h|libs/ra8_sdmmc_spi/src/ra8_sdmmc_spi_core_contracts_internal\.h|libs/ra8_sdmmc_spi/src/ra8_sdmmc_spi_io_contracts_internal\.h|port/mbedtls/inc/tf_psa_crypto_config\.h|port/mbedtls/inc/tf_psa_crypto_config_platform\.h|port/nimble/inc/nimble/nimble_npl_os\.h|port/posix/src/fw_if_fs_posix_contracts_internal\.h|port/posix/src/fw_if_fs_posix_stream_contracts_internal\.h|tests/storage/inc/test_ra8_fs_check_util\.h|tests/storage/inc/test_ra8_fs_format_fixture\.h|tests/support/inc/fs_sparse_backend_test_util\.h|tests/support/inc/ra8_cache_store_fixture\.h|tests/support/inc/ra8_gpio_test_contracts\.h|tests/support/inc/ra8_jpeg_sw_decode_cov_fixture\.h|tests/support/inc/ra8_keyboard_test_contracts\.h|tests/support/inc/ra8_mpu_test_internal\.h|tests/support/inc/ra8_power_profile_test_contracts\.h|tests/support/inc/ra8_tls_net_test_contracts\.h|tests/support/inc/ra8_tls_test_contracts\.h|tests/support/inc/ra8_touch_cal_test_contracts\.h|tests/usb/inc/test_ra8_usb_hmsc_enum_fixture\.h)$'

CheckOptions:
  # --- vendor RTOS ABI symbol names ---
  #
  # ThreadX and USBX define these names themselves; a first-party TU that
  # implements or declares one MUST spell it exactly as the vendor does or the
  # image links against nothing. The leading underscore is the vendor's
  # choice, not ours. This is the same situation as Reset_Handler and the
  # libFuzzer entry points already exempted below: an externally-fixed ABI
  # name, where renaming to satisfy the checker produces a binary that builds
  # and then does not work.
  #
  # Listed by exact name, never by a broad `_*` pattern, so a genuinely
  # reserved identifier we invented ourselves is still caught.
  - key: bugprone-reserved-identifier.AllowedIdentifiers
    value: '_tx_timer_interrupt;_ux_dcd_ra8_usb_function;_ux_hcd_ra8_usb_function;_GNU_SOURCE;_POSIX_C_SOURCE'
  # cert-dcl37-c and cert-dcl51-cpp are aliases of the check above; an alias
  # reads its own option block, so the allowlist must be stated for each.
  - key: cert-dcl37-c.AllowedIdentifiers
    value: '_tx_timer_interrupt;_ux_dcd_ra8_usb_function;_ux_hcd_ra8_usb_function;_GNU_SOURCE;_POSIX_C_SOURCE'
  - key: cert-dcl51-cpp.AllowedIdentifiers
    value: '_tx_timer_interrupt;_ux_dcd_ra8_usb_function;_ux_hcd_ra8_usb_function;_GNU_SOURCE;_POSIX_C_SOURCE'

  # --- readability-identifier-naming (CLAUDE.md naming conventions) ---

  # Functions: snake_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  # Allow UPPER_CASE for ARM Cortex-M interrupt handler names that are
  # fixed by the vector table (Reset_Handler, NMI_Handler, HardFault_Handler,
  # SysTick_Handler, Default_Handler, and the IRQ<N>_Handler pattern), and for
  # the libFuzzer entry points (LLVMFuzzerTestOneInput / LLVMFuzzerInitialize),
  # whose spelling is fixed by the libFuzzer runtime ABI exactly the same way:
  # rename them and the harness links but is never called. Register_ETHOSU is
  # the same case for TFLite-micro: the vendored MicroMutableOpResolver resolves
  # the ethos-u operator by calling `tflite::Register_ETHOSU()` by that exact
  # name (the first-party kernel replaces the vendored stub of the same symbol),
  # so renaming it links against nothing.
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^(SystemInit|Reset_Handler|Default_Handler|NMI_Handler|HardFault_Handler|MemManage_Handler|BusFault_Handler|UsageFault_Handler|SecureFault_Handler|SVC_Handler|DebugMon_Handler|PendSV_Handler|SysTick_Handler|IRQ[0-9]+_Handler|[A-Z][A-Za-z0-9]*_IRQHandler|LLVMFuzzer[A-Za-z0-9]+|_tx_[a-z0-9_]+|_ux_[a-z0-9_]+|Register_ETHOSU)$'

  # Variables: snake_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case

  # Local variables: snake_case (no prefix)
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case

  # Local constants: snake_case (no prefix)
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case

  # Parameters: snake_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case

  # Const parameters: snake_case (no prefix)
  - key: readability-identifier-naming.ConstantParameterCase
    value: lower_case

  # Types (struct/typedef/enum): snake_case with trailing _t
  - key: readability-identifier-naming.TypedefCase
    value: lower_case
  - key: readability-identifier-naming.TypedefSuffix
    value: _t
  # Allow _fn suffix for function pointer typedefs (e.g. ra8_error_report_fn)
  - key: readability-identifier-naming.TypedefIgnoredRegexp
    value: '.*_fn$'

  # Struct names: snake_case (without _t -- the typedef carries it)
  - key: readability-identifier-naming.StructCase
    value: lower_case

  # Enum tag names: snake_case
  - key: readability-identifier-naming.EnumCase
    value: lower_case

  # Enum constants: k_ prefix, lower_case (project convention)
  - key: readability-identifier-naming.EnumConstantCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k_

  # Macros: UPPER_CASE (SCREAMING_SNAKE_CASE)
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  # Allow lowercase macros for function-like logging/check macros, and the
  # standard feature-test macros (_GNU_SOURCE, _POSIX_C_SOURCE, ...), whose
  # leading underscore UPPER_CASE rejects. Their spelling is fixed by ISO C
  # and by glibc; a file that needs one has no alternative name to use, so
  # flagging them reports a rule the code cannot satisfy. Scoped to the
  # leading-underscore-then-uppercase shape, so an ordinary lowercase macro
  # is still caught.
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^(ra8_log_|__ARM|__CORTEX|_[A-Z][A-Z0-9_]*$).*'

  # Global variables (non-static, non-const): g_ prefix
  # Note: clang-tidy classifies file-scope 'static' vars as "global" in C.
  # IgnoredRegexp accepts our s_ prefix for file-scope statics while still
  # enforcing g_ for true (non-static) globals.
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: g_
  # Accept s_ for file-scope statics and leading-underscore names for
  # linker-provided symbols (_stack_top, _sdata, _edata, _sbss, _ebss,
  # _sidata, _sheap, _eheap, __exidx_start, __exidx_end, ...).
  - key: readability-identifier-naming.GlobalVariableIgnoredRegexp
    value: '^(s_|_+).*'

  # Global constants (non-static const): g_ prefix
  # IgnoredRegexp accepts s_ (static impl details) and k_ (named constants).
  - key: readability-identifier-naming.GlobalConstantCase
    value: lower_case
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: g_
  # Accept s_ / k_ prefixes and leading-underscore linker symbols.
  - key: readability-identifier-naming.GlobalConstantIgnoredRegexp
    value: '^(s_|k_|_+).*'

  # Static variables (non-const): s_ prefix
  - key: readability-identifier-naming.StaticVariableCase
    value: lower_case
  - key: readability-identifier-naming.StaticVariablePrefix
    value: s_

  # Static constants: lower_case, accept both s_ and k_ prefixes.
  # s_ for implementation details (s_tag), k_ for named constants (k_max_retries).
  - key: readability-identifier-naming.StaticConstantCase
    value: lower_case

  # --- cert-str34-c: cast char to unsigned char before conversion ---
  - key: cert-str34-c.DiagnoseSignedUnsignedCharComparisons
    value: true

  # --- readability-magic-numbers: small integers used for padding and
  # small array counts in register structs are exempt. Real register
  # constants (offsets, masks, field shifts) must still use named enums.
  - key: readability-magic-numbers.IgnoredIntegerValues
    value: "0;1;2;3;4;6;8;16;32"
  - key: readability-magic-numbers.IgnoredFloatingPointValues
    value: "0.0;1.0"

  # --- readability-function-cognitive-complexity: NASA Power of 10 Rule 4 ---
  - key: readability-function-cognitive-complexity.Threshold
    value: "25"

  # --- readability-function-size: Clean Code / NASA Rule 4 function-length limit ---
  - key: readability-function-size.LineThreshold
    value: "60"
  - key: readability-function-size.StatementThreshold
    value: "40"
  - key: readability-function-size.NestingThreshold
    value: "4"
