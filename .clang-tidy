---
# ra8-firmware - clang-tidy configuration
#
# Run against the host-compiled test build (tests/build/compile_commands.json)
# because the cross-compiler (arm-none-eabi-gcc) emits Cortex-M85-specific
# flags that LLVM cannot always parse cleanly. All firmware source files are
# compiled into the test build via standard gcc/clang, so full coverage is
# achieved.
#
# Minimum clang version: 16 (required for C23 typed enum syntax).
# Ubuntu 24.04 ships clang-18 via the unversioned 'clang-tidy' package.
#
# Usage:
#   cmake -B build/tidy -S tests/ -DENABLE_CLANG_TIDY=ON
#   cmake --build build/tidy
#
# Or via script:
#   bash scripts/checks/clang_tidy.sh --check

#
# Disabled checks (each line carries the rationale for why it is off,
# verified by re-enabling the check and counting real violations):
#
#  -bugprone-easily-swappable-parameters     (137 violations)
#      Fires on every `(uint8_t channel, uint8_t pin)` HAL signature.
#      Eliminating means wrapping each pair in a typed struct -- API
#      churn for marginal safety gain on register-index parameters.
#  -misc-include-cleaner                      (156 violations)
#      Flags umbrella headers like `ra8_regs.h` that re-export every
#      per-peripheral regs header for convenience, plus `ra8_check.h`
#      re-exporting `ra8_err.h`. The pattern is intentional.
#  -performance-no-int-to-ptr                 (179 violations)
#      Every MMIO accessor *is* an int-to-pointer cast:
#      `(volatile T*)0x40080000`. Fundamental to bare-metal register
#      access; cannot be eliminated without abandoning the HAL pattern.
#  -portability-avoid-pragma-once             (clang-tidy v22)
#      The project mandates `#pragma once` (CLAUDE.md "Header Guards").
#      v18 doesn't fire this on our headers; v22 does. Disable so the
#      Homebrew/macOS pre-commit run agrees with CI.
#  -clang-analyzer-core.FixedAddressDereference  (clang-tidy v22)
#      Dereferencing fixed MMIO addresses is the whole point of the
#      HAL. v18 doesn't surface this on our register access patterns;
#      v22 does, throughout libs/ra8_hal/, libs/ra8_core/, and the
#      per-app boot files. Disable globally.
#  -misc-use-internal-linkage                  (clang-tidy v22)
#      Flags vector-table entries (Reset_Handler, Default_Handler,
#      SystemInit, _sbrk, IRQ handlers) as if they should be `static`,
#      breaking the linker's external resolution. v18 doesn't fire on
#      these; v22 does. Disable globally.
#  -readability-identifier-length             (21 violations after
#                                              relaxing thresholds)
#      The remaining short names are comparator `(a, b)` parameters and
#      obvious-context `p` (pointer) / `v` (value) / `t` (timing) in
#      static helpers. Renaming them to 3+ chars would make the code
#      harder to read, not easier.
#  -readability-implicit-bool-conversion      (~120 spurious
#                                              auto-fixes in v18)
#      C/C++ semantic mismatch in clang-tidy 18: relational operators
#      like `==`, `!=`, `<` produce `int` in C (per C standard) rather
#      than `bool`, so the check fires on idiomatic `return x != y;`
#      bodies. Its auto-fixer wraps them in `(x != y) != 0`, which
#      is identical noise. v22 doesn't flag the same code at all.
#  -clang-analyzer-optin.core.EnumCastOutOfRange  (376 violations, none of
#                                                  them reachable defects)
#      Models the C++ rule that converting an out-of-enumerator value to a
#      *scoped* enum is undefined. It is not undefined here: CLAUDE.md
#      mandates that every enum in this tree declare an explicit underlying
#      type (`typedef enum : uint8_t`), and C23 6.7.2.2 makes conversion of
#      any value representable in that fixed underlying type well-defined.
#      What the check actually flags is (a) the negative tests -- passing
#      `(ra8_ipc_core_id_t)0xFFU` is the only way to prove a driver rejects a
#      bogus enum argument, and it is precisely what the test exists to do --
#      and (b) the flag-enum idiom
#      `(ra8_psa_key_usage_t)(k_..._encrypt | k_..._decrypt)`, whose OR is a
#      valid bit pattern rather than a named enumerator. Neither can be
#      rewritten without deleting the test or inventing production
#      enumerators that exist only to satisfy the analyzer.
#  -clang-analyzer-valist.Unterminated         (non-deterministic;
#                                               guards zero first-party code)
#      No first-party TU uses <stdarg.h>: grep for va_list / va_start /
#      va_end across libs/ src/ port/ examples/ tools/ tests/ finds none,
#      so this checker protects nothing here. The path-sensitive analyzer
#      nonetheless intermittently reports a phantom "Initialized va_list
#      is leaked" against ra8_reflow_render.c (a function with no va_list
#      at all), failing one CI run and passing the next on byte-identical
#      code. Disable it to stop the flake.
#
Checks: >
  cert-*,
  bugprone-*,
  clang-analyzer-*,
  misc-*,
  readability-*,
  portability-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-core.FixedAddressDereference,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-valist.Unterminated,
  -misc-include-cleaner,
  -misc-use-internal-linkage,
  -performance-no-int-to-ptr,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-redundant-casting,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

# ALL warnings are errors -- zero tolerance for any clang-tidy violation.
WarningsAsErrors: '*'

# Only report diagnostics for project-authored headers; suppress noise from
# CMake-fetched deps and generated build trees. Our register headers
# (ra8d2_*_regs.h) and host-test mocks (tests/mocks/) are in-house code
# and ARE linted.
HeaderFilterRegex: '^(?!.*(_deps|build/)).*\.(h|hpp)$'

CheckOptions:
  # --- vendor RTOS ABI symbol names ---
  #
  # ThreadX and USBX define these names themselves; a first-party TU that
  # implements or declares one MUST spell it exactly as the vendor does or the
  # image links against nothing. The leading underscore is the vendor's
  # choice, not ours. This is the same situation as Reset_Handler and the
  # libFuzzer entry points already exempted below: an externally-fixed ABI
  # name, where renaming to satisfy the checker produces a binary that builds
  # and then does not work.
  #
  # Listed by exact name, never by a broad `_*` pattern, so a genuinely
  # reserved identifier we invented ourselves is still caught.
  - key: bugprone-reserved-identifier.AllowedIdentifiers
    value: '_tx_timer_interrupt;_ux_dcd_ra8_usb_function;_ux_hcd_ra8_usb_function'

  # --- readability-identifier-naming (CLAUDE.md naming conventions) ---

  # Functions: snake_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  # Allow UPPER_CASE for ARM Cortex-M interrupt handler names that are
  # fixed by the vector table (Reset_Handler, NMI_Handler, HardFault_Handler,
  # SysTick_Handler, Default_Handler, and the IRQ<N>_Handler pattern), and for
  # the libFuzzer entry points (LLVMFuzzerTestOneInput / LLVMFuzzerInitialize),
  # whose spelling is fixed by the libFuzzer runtime ABI exactly the same way:
  # rename them and the harness links but is never called.
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^(SystemInit|Reset_Handler|Default_Handler|NMI_Handler|HardFault_Handler|MemManage_Handler|BusFault_Handler|UsageFault_Handler|SecureFault_Handler|SVC_Handler|DebugMon_Handler|PendSV_Handler|SysTick_Handler|IRQ[0-9]+_Handler|[A-Z][A-Za-z0-9]*_IRQHandler|LLVMFuzzer[A-Za-z0-9]+|_tx_[a-z0-9_]+|_ux_[a-z0-9_]+)$'

  # Variables: snake_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case

  # Local variables: snake_case (no prefix)
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case

  # Local constants: snake_case (no prefix)
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case

  # Parameters: snake_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case

  # Const parameters: snake_case (no prefix)
  - key: readability-identifier-naming.ConstantParameterCase
    value: lower_case

  # Types (struct/typedef/enum): snake_case with trailing _t
  - key: readability-identifier-naming.TypedefCase
    value: lower_case
  - key: readability-identifier-naming.TypedefSuffix
    value: _t
  # Allow _fn suffix for function pointer typedefs (e.g. ra8_error_report_fn)
  - key: readability-identifier-naming.TypedefIgnoredRegexp
    value: '.*_fn$'

  # Struct names: snake_case (without _t -- the typedef carries it)
  - key: readability-identifier-naming.StructCase
    value: lower_case

  # Enum tag names: snake_case
  - key: readability-identifier-naming.EnumCase
    value: lower_case

  # Enum constants: k_ prefix, lower_case (project convention)
  - key: readability-identifier-naming.EnumConstantCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k_

  # Macros: UPPER_CASE (SCREAMING_SNAKE_CASE)
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  # Allow lowercase macros for function-like logging/check macros.
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^(ra8_log_|__ARM|__CORTEX).*'

  # Global variables (non-static, non-const): g_ prefix
  # Note: clang-tidy classifies file-scope 'static' vars as "global" in C.
  # IgnoredRegexp accepts our s_ prefix for file-scope statics while still
  # enforcing g_ for true (non-static) globals.
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: g_
  # Accept s_ for file-scope statics and leading-underscore names for
  # linker-provided symbols (_stack_top, _sdata, _edata, _sbss, _ebss,
  # _sidata, _sheap, _eheap, __exidx_start, __exidx_end, ...).
  - key: readability-identifier-naming.GlobalVariableIgnoredRegexp
    value: '^(s_|_+).*'

  # Global constants (non-static const): g_ prefix
  # IgnoredRegexp accepts s_ (static impl details) and k_ (named constants).
  - key: readability-identifier-naming.GlobalConstantCase
    value: lower_case
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: g_
  # Accept s_ / k_ prefixes and leading-underscore linker symbols.
  - key: readability-identifier-naming.GlobalConstantIgnoredRegexp
    value: '^(s_|k_|_+).*'

  # Static variables (non-const): s_ prefix
  - key: readability-identifier-naming.StaticVariableCase
    value: lower_case
  - key: readability-identifier-naming.StaticVariablePrefix
    value: s_

  # Static constants: lower_case, accept both s_ and k_ prefixes.
  # s_ for implementation details (s_tag), k_ for named constants (k_max_retries).
  - key: readability-identifier-naming.StaticConstantCase
    value: lower_case

  # --- cert-str34-c: cast char to unsigned char before conversion ---
  - key: cert-str34-c.DiagnoseSignedUnsignedCharComparisons
    value: true

  # --- readability-magic-numbers: small integers used for padding and
  # small array counts in register structs are exempt. Real register
  # constants (offsets, masks, field shifts) must still use named enums.
  - key: readability-magic-numbers.IgnoredIntegerValues
    value: "0;1;2;3;4;6;8;16;32"
  - key: readability-magic-numbers.IgnoredFloatingPointValues
    value: "0.0;1.0"

  # --- readability-function-cognitive-complexity: NASA Power of 10 Rule 4 ---
  - key: readability-function-cognitive-complexity.Threshold
    value: "25"

  # --- readability-function-size: Clean Code / NASA Rule 4 function-length limit ---
  - key: readability-function-size.LineThreshold
    value: "60"
  - key: readability-function-size.StatementThreshold
    value: "40"
  - key: readability-function-size.NestingThreshold
    value: "4"
